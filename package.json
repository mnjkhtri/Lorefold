{
  "name": "lorefold",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "data:generate": "tsx scripts/generate-static-data.ts",
    "build": "tsc --noEmit && node --experimental-global-webcrypto node_modules/vite/bin/vite.js build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts tests/unit",
    "test:integration": "vitest run --config vitest.config.ts tests/integration",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "postal-mime": "^3.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "^6.28.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "9.17.0",
    "@playwright/test": "1.49.1",
    "@types/node": "^22.10.5",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "eslint": "9.17.0",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.0",
    "vite": "6.1.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "2.1.8"
  }
}
