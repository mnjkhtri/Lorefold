ation\nfails, probe returns without releasing the channel because the remove\ncallback is not invoked after a failed probe."},{"kind":"paragraph","text":"Use devm_dma_request_chan() so the device core releases the channel on\nprobe failure and driver detach. Remove the manual release from the\nremove callback because the channel is now device-managed."},{"kind":"paragraph","text":"This issue was found by a static analysis checker and confirmed by\nmanual source review."},{"kind":"code","text":"Fixes: 62885f59a261 (\"MXS: Implement DMA support into mxs-i2c\")"},{"kind":"paragraph","text":"Assisted-by: unnamed:claude-opus-4.8 typestate\nSigned-off-by: Ruoyu Wang <ruoyuw560@gmail.com>"},{"kind":"patch","patchId":"patch:20260815151720.3757460-1-ruoyuw560@gmail.com:0:0"}],"patchIds":["patch:20260815151720.3757460-1-ruoyuw560@gmail.com:0:0"],"attachmentMetadata":[],"sourceOrdinal":0,"diagnostics":[]}},"rootIds":["20260815151720.3757460-1-ruoyuw560@gmail.com"],"childrenByParent":{},"chronologicalIds":["20260815151720.3757460-1-ruoyuw560@gmail.com"],"patchSeries":[],"diagnostics":[],"patches":{"patch:20260815151720.3757460-1-ruoyuw560@gmail.com:0:0":{"id":"patch:20260815151720.3757460-1-ruoyuw560@gmail.com:0:0","messageId":"20260815151720.3757460-1-ruoyuw560@gmail.com","subject":"[PATCH v2] i2c: mxs: fix DMA channel leak on probe error","commitMessage":[],"files":[{"oldPath":"drivers/i2c/busses/i2c-mxs.c","newPath":"drivers/i2c/busses/i2c-mxs.c","displayPath":"drivers/i2c/busses/i2c-mxs.c","status":"modified","hunks":[{"header":"@@ -839,7 +839,7 @@ static int mxs_i2c_probe(struct platform_device *pdev)","oldStart":839,"oldCount":7,"newStart":839,"newCount":7,"lines":[{"kind":"context","text":"\t}","oldLine":839,"newLine":839},{"kind":"context","text":"","oldLine":840,"newLine":840},{"kind":"context","text":"\t/* Setup the DMA */","oldLine":841,"newLine":841},{"kind":"deletion","text":"\ti2c->dmach = dma_request_chan(dev, \"rx-tx\");","oldLine":842},{"kind":"addition","text":"\ti2c->dmach = devm_dma_request_chan(dev, \"rx-tx\");","newLine":842},{"kind":"context","text":"\tif (IS_ERR(i2c->dmach)) {","oldLine":843,"newLine":843},{"kind":"context","text":"\t\treturn dev_err_probe(dev, PTR_ERR(i2c->dmach),","oldLine":844,"newLine":844},{"kind":"context","text":"\t\t\t\t     \"Failed to request dma\\n\");","oldLine":845,"newLine":845}]},{"header":"@@ -877,9 +877,6 @@ static void mxs_i2c_remove(struct platform_device *pdev)","oldStart":877,"oldCount":9,"newStart":877,"newCount":6,"lines":[{"kind":"context","text":"","oldLine":877,"newLine":877},{"kind":"context","text":"\ti2c_del_adapter(&i2c->adapter);","oldLine":878,"newLine":878},{"kind":"context","text":"","oldLine":879,"newLine":879},{"kind":"deletion","text":"\tif (i2c->dmach)","oldLine":880},{"kind":"deletion","text":"\t\tdma_release_channel(i2c->dmach);","oldLine":881},{"kind":"deletion","text":"","oldLine":882},{"kind":"context","text":"\twritel(MXS_I2C_CTRL0_SFTRST, i2c->regs + MXS_I2C_CTRL0_SET);","oldLine":883,"newLine":880},{"kind":"context","text":"}","oldLine":884,"newLine":881},{"kind":"context","text":"","oldLine":885,"newLine":882},{"kind":"deletion","text":"- ","oldLine":886},{"kind":"metadata","text":"2.51.0"},{"kind":"metadata","text":""},{"kind":"metadata","text":""}]}],"binary":false}],"trailers":[],"rawText":"diff --git a/drivers/i2c/busses/i2c-mxs.c b/drivers/i2c/busses/i2c-mxs.c\nindex 4e07babea9c3f4..eee4fdcd9df31a 100644\n--- a/drivers/i2c/busses/i2c-mxs.c\n+++ b/drivers/i2c/busses/i2c-mxs.c\n@@ -839,7 +839,7 @@ static int mxs_i2c_probe(struct platform_device *pdev)\n \t}\n \n \t/* Setup the DMA */\n-\ti2c->dmach = dma_request_chan(dev, \"rx-tx\");\n+\ti2c->dmach = devm_dma_request_chan(dev, \"rx-tx\");\n \tif (IS_ERR(i2c->dmach)) {\n \t\treturn dev_err_probe(dev, PTR_ERR(i2c->dmach),\n \t\t\t\t     \"Failed to request dma\\n\");\n@@ -877,9 +877,6 @@ static void mxs_i2c_remove(struct platform_device *pdev)\n \n \ti2c_del_adapter(&i2c->adapter);\n \n-\tif (i2c->dma