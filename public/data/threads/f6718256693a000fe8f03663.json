{"schemaVersion":1,"generatedAt":"2026-08-16T16:20:46.501Z","id":"f6718256693a000fe8f03663","canonicalUrl":"https://lore.kernel.org/r/20260812092322.3423217-1-lgs201920130244%40gmail.com/","channels":["linux-i2c"],"thread":{"schemaVersion":1,"id":"thread:lore-git:20260812092322.3423217-1-lgs201920130244@gmail.com","source":{"kind":"static-generated","canonicalThreadUrl":"https://lore.kernel.org/r/20260812092322.3423217-1-lgs201920130244%40gmail.com/","fetchedAt":"2026-08-16T16:20:46.501Z","contentDigest":"lore-git:20260812092322.3423217-1-lgs201920130244@gmail.com"},"subject":"[PATCH] i2c: nvidia-gpu: fix autosuspend cleanup","messages":{"20260812092322.3423217-1-lgs201920130244@gmail.com":{"id":"20260812092322.3423217-1-lgs201920130244@gmail.com","messageId":"20260812092322.3423217-1-lgs201920130244@gmail.com","references":[],"missingAncestorIds":[],"author":{"name":"Guangshuo Li","address":"lgs201920130244@gmail.com"},"replyTo":[],"to":[{"name":"Ajay Gupta","address":"ajayg@nvidia.com"},{"name":"Andi Shyti","address":"andi.shyti@kernel.org"},{"name":"Wolfram Sang","address":"wsa@kernel.org"},{"name":"","address":"linux-i2c@vger.kernel.org"},{"name":"","address":"linux-kernel@vger.kernel.org"}],"cc":[{"name":"Guangshuo Li","address":"lgs201920130244@gmail.com"},{"name":"","address":"stable@vger.kernel.org"}],"timestamp":{"raw":"2026-08-12T09:23:22.000Z","iso":"2026-08-12T09:23:22.000Z","valid":true},"subject":"[PATCH] i2c: nvidia-gpu: fix autosuspend cleanup","mailingLists":[{"id":"linux-i2c.vger.kernel.org","displayName":"linux-i2c.vger.kernel.org"}],"blocks":[{"kind":"paragraph","text":"gpu_i2c_probe() calls pm_runtime_use_autosuspend(), but the remove\npath does not call the matching pm_runtime_dont_use_autosuspend()."},{"kind":"paragraph","text":"If the autosuspend delay is set to a negative value while autosuspend\nis enabled, the runtime PM core increments usage_count to prevent\nruntime suspend. Without undoing the autosuspend setting during\nteardown, this reference is not dropped and usage_count remains\nunbalanced."},{"kind":"paragraph","text":"Call pm_runtime_dont_use_autosuspend() during driver removal to\nproperly undo the autosuspend setting."},{"kind":"paragraph","text":"This issue was found by manual code inspection."},{"kind":"code","text":"Fixes: d4a4f927e4dd (\"i2c: nvidia-gpu: add runtime pm support\")\nCc: stable@vger.kernel.org"},{"kind":"paragraph","text":"Signed-off-by: Guangshuo Li <lgs201920130244@gmail.com>"},{"kind":"patch","patchId":"patch:20260812092322.3423217-1-lgs201920130244@gmail.com:0:0"}],"patchIds":["patch:20260812092322.3423217-1-lgs201920130244@gmail.com:0:0"],"attachmentMetadata":[],"sourceOrdinal":0,"diagnostics":[]}},"rootIds":["20260812092322.3423217-1-lgs201920130244@gmail.com"],"childrenByParent":{},"chronologicalIds":["20260812092322.3423217-1-lgs201920130244@gmail.com"],"patchSeries":[],"diagnostics":[],"patches":{"patch:20260812092322.3423217-1-lgs201920130244@gmail.com:0:0":{"id":"patch:20260812092322.3423217-1-lgs201920130244@gmail.com:0:0","messageId":"20260812092322.3423217-1-lgs201920130244@gmail.com","subject":"[PATCH] i2c: nvidia-gpu: fix autosuspend cleanup","commitMessage":[],"files":[{"oldPath":"drivers/i2c/busses/i2c-nvidia-gpu.c","newPath":"drivers/i2c/busses/i2c-nvidia-gpu.c","displayPath":"drivers/i2c/busses/i2c-nvidia-gpu.c","status":"modified","hunks":[{"header":"@@ -334,6 +334,7 @@ static void gpu_i2c_remove(struct pci_dev *pdev)","oldStart":334,"oldCount":6,"newStart":334,"newCount":7,"lines":[{"kind":"context","text":"\tstruct gpu_i2c_dev *i2cd = pci_get_drvdata(pdev);","oldLine":334,"newLine":334},{"kind":"context","text":"","oldLine":335,"newLine":335},{"kind":"context","text":"\tpm_runtime_get_noresume(i2cd->dev);","oldLine":336,"newLine":336},{"kind":"addition","text":"\tpm_runtime_dont_use_autosuspend(i2cd->dev);","newLine":337},{"kind":"context","text":"\ti2c_del_adapter(&i2cd->adapter);","oldLine":337,"newLine":338},{"kind":"context","text":"\tpci_free_irq_vectors(pdev);","oldLine":338,"newLine":339},{"kind":"context","text":"}","oldLine":339,"newLine":340},{"kind":"deletion","text":"- ","oldLine":340},{"kind":"metadata","text":"2.43.0"},{"kind":"metadata","text":""},{"kind":"metadata","text":""}]}],"binary":false}],"trailers":[],"rawText":"diff --git a/drivers/i2c/busses/i2c-nvidia-gpu.c b/drivers/i2c/busses/i2c-nvidia-gpu.c\nindex 14c059b03945..9dbe1fe22412 100644\n--- a/drivers/i2c/busses/i2c-nvidia-gpu.c\n+++ b/drivers/i2c/busses/i2c-nvidia-gpu.c\n@@ -334,6 +334,7 @@ static void gpu_i2c_remove(struct pci_dev *pdev)\n \tstruct gpu_i2c_dev *i2cd = pci_get_drvdata(pdev);\n \n \tpm_runtime_get_noresume(i2cd->dev);\n+\tpm_runtime_dont_use_autosuspend(i2cd->dev);\n \ti2c_del_adapter(&i2cd->adapter);\n \tpci_free_irq_vectors(pdev);\n }\n-- \n2.43.0\n\n","statistics":{"files":1,"additions":1,"deletions":1},"diagnostics":[]}}}}