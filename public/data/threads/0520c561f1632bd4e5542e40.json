{"schemaVersion":1,"generatedAt":"2026-08-16T16:20:46.501Z","id":"0520c561f1632bd4e5542e40","canonicalUrl":"https://lore.kernel.org/r/20260806111018.782380-1-tommaso.merciai.xr%40bp.renesas.com/","channels":["linux-i2c"],"thread":{"schemaVersion":1,"id":"thread:lore-git:20260806111018.782380-1-tommaso.merciai.xr@bp.renesas.com","source":{"kind":"static-generated","canonicalThreadUrl":"https://lore.kernel.org/r/20260806111018.782380-1-tommaso.merciai.xr%40bp.renesas.com/","fetchedAt":"2026-08-16T16:20:46.501Z","contentDigest":"lore-git:20260806111018.782380-1-tommaso.merciai.xr@bp.renesas.com"},"subject":"Re: [PATCH v2] dt-bindings: i2c: renesas,riic: Drop clock-frequency from required","messages":{"178650336197.631765.122141109682113788.robh@kernel.org":{"id":"178650336197.631765.122141109682113788.robh@kernel.org","messageId":"178650336197.631765.122141109682113788.robh@kernel.org","references":["20260806111018.782380-1-tommaso.merciai.xr@bp.renesas.com"],"missingAncestorIds":["20260806111018.782380-1-tommaso.merciai.xr@bp.renesas.com"],"author":{"name":"Rob Herring (Arm)","address":"robh@kernel.org"},"replyTo":[],"to":[{"name":"Tommaso Merciai","address":"tommaso.merciai.xr@bp.renesas.com"}],"cc":[{"name":"","address":"tomm.merciai@gmail.com"},{"name":"Andi Shyti","address":"andi.shyti@kernel.org"},{"name":"Wolfram Sang","address":"wsa+renesas@sang-engineering.com"},{"name":"Magnus Damm","address":"magnus.damm@gmail.com"},{"name":"Chris Brandt","address":"chris.brandt@renesas.com"},{"name":"","address":"devicetree@vger.kernel.org"},{"name":"Krzysztof Kozlowski","address":"krzk+dt@kernel.org"},{"name":"Geert Uytterhoeven","address":"geert+renesas@glider.be"},{"name":"","address":"linux-i2c@vger.kernel.org"},{"name":"","address":"linux-renesas-soc@vger.kernel.org"},{"name":"","address":"linux-kernel@vger.kernel.org"},{"name":"Conor Dooley","address":"conor+dt@kernel.org"},{"name":"","address":"biju.das.jz@bp.renesas.com"}],"timestamp":{"raw":"2026-08-12T02:56:02.000Z","iso":"2026-08-12T02:56:02.000Z","valid":true},"subject":"Re: [PATCH v2] dt-bindings: i2c: renesas,riic: Drop clock-frequency from required","mailingLists":[{"id":"linux-i2c.vger.kernel.org","displayName":"linux-i2c.vger.kernel.org"}],"blocks":[{"kind":"quote","attribution":"On Thu, 06 Aug 2026 13:10:13 +0200, Tommaso Merciai wrote:","lines":[{"depth":1,"text":"clock-frequency is described as optional, with 100 kHz assumed when"},{"depth":1,"text":"absent, yet it is also listed as required."},{"depth":1,"text":""},{"depth":1,"text":"The description is correct: i2c-riic calls i2c_parse_fw_timings() with"},{"depth":1,"text":"use_defaults set, so the core falls back to I2C_MAX_STANDARD_MODE_FREQ"},{"depth":1,"text":"when the property is absent."},{"depth":1,"text":""},{"depth":1,"text":"The stale requirement only produces dtbs_check noise on boards relying"},{"depth":1,"text":"on the default:"},{"depth":1,"text":""},{"depth":1,"text":"  i2c@14400800 (renesas,riic-r9a09g047): 'clock-frequency' is a"},{"depth":1,"text":"  required property"},{"depth":1,"text":""},{"depth":1,"text":"Drop it."},{"depth":1,"text":""},{"depth":1,"text":"Signed-off-by: Tommaso Merciai <tommaso.merciai.xr@bp.renesas.com>"},{"depth":1,"text":"---"},{"depth":1,"text":"v1->v2:"},{"depth":1,"text":" - Dropped all v1 series, need a rework."},{"depth":1,"text":" - Fixed dtbs_check failure by dropping clock-frequency from the required list,"},{"depth":1,"text":"   instead of adding it to the dts, as the absence of this property"},{"depth":1,"text":"   indicates the default frequency 100 kHz."},{"depth":1,"text":"   v1: https://lore.kernel.org/all/20260803132828.3249424-3-tommaso.merciai.xr@bp.renesas.com/"},{"depth":1,"text":""},{"depth":1,"text":" Documentation/devicetree/bindings/i2c/renesas,riic.yaml | 1 -"},{"depth":1,"text":" 1 file changed, 1 deletion(-)"},{"depth":1,"text":""}],"lineCount":27,"maximumDepth":1},{"kind":"paragraph","text":"Acked-by: Rob Herring (Arm) <robh@kernel.org>"}],"patchIds":[],"attachmentMetadata":[],"sourceOrdinal":0,"diagnostics":[],"declaredParentMessageId":"20260806111018.782380-1-tommaso.merciai.xr@bp.renesas.com"}},"rootIds":["178650336197.631765.122141109682113788.robh@kernel.org"],"childrenByParent":{},"chronologicalIds":["178650336197.631765.122141109682113788.robh@kernel.org"],"patchSeries":[],"diagnostics":[],"patches":{}}}