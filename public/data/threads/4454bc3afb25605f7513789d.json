{"schemaVersion":1,"generatedAt":"2026-08-16T16:20:46.501Z","id":"4454bc3afb25605f7513789d","canonicalUrl":"https://lore.kernel.org/r/20260813082049.41209-2-thorsten.blum%40linux.dev/","channels":["platform-driver-x86"],"thread":{"schemaVersion":1,"id":"thread:lore-git:20260813082049.41209-2-thorsten.blum@linux.dev","source":{"kind":"static-generated","canonicalThreadUrl":"https://lore.kernel.org/r/20260813082049.41209-2-thorsten.blum%40linux.dev/","fetchedAt":"2026-08-16T16:20:46.501Z","contentDigest":"lore-git:20260813082049.41209-2-thorsten.blum@linux.dev"},"subject":"[PATCH v2] platform/x86: think-lmi: Fix current password length check","messages":{"20260813082049.41209-2-thorsten.blum@linux.dev":{"id":"20260813082049.41209-2-thorsten.blum@linux.dev","messageId":"20260813082049.41209-2-thorsten.blum@linux.dev","references":[],"missingAncestorIds":[],"author":{"name":"Thorsten Blum","address":"thorsten.blum@linux.dev"},"replyTo":[],"to":[{"name":"Mark Pearson","address":"mpearson-lenovo@squebb.ca"},{"name":"Derek J. Clark","address":"derekjohn.clark@gmail.com"},{"name":"Hans de Goede","address":"hansg@kernel.org"},{"name":"Ilpo Järvinen","address":"ilpo.jarvinen@linux.intel.com"}],"cc":[{"name":"Thorsten Blum","address":"thorsten.blum@linux.dev"},{"name":"","address":"stable@vger.kernel.org"},{"name":"Mark Pearson","address":"markpearson@lenovo.com"},{"name":"","address":"platform-driver-x86@vger.kernel.org"},{"name":"","address":"linux-kernel@vger.kernel.org"}],"timestamp":{"raw":"2026-08-13T08:20:49.000Z","iso":"2026-08-13T08:20:49.000Z","valid":true},"subject":"[PATCH v2] platform/x86: think-lmi: Fix current password length check","mailingLists":[{"id":"platform-driver-x86.vger.kernel.org","displayName":"platform-driver-x86.vger.kernel.org"}],"blocks":[{"kind":"paragraph","text":"current_password_store() checks the password length before removing the\ntrailing newline, which can reject valid passwords that are exactly\n->maxlen bytes long."},{"kind":"paragraph","text":"It also passes ->maxlen to strscpy(), which truncates passwords without\na newline."},{"kind":"paragraph","text":"Use strchrnul() to measure the password length up to the newline, then\ncopy that many bytes and add a trailing NUL terminator."},{"kind":"code","text":"Fixes: a40cd7ef22fb (\"platform/x86: think-lmi: Add WMI interface support on Lenovo platforms\")\nCc: stable@vger.kernel.org"},{"kind":"paragraph","text":"Signed-off-by: Thorsten Blum <thorsten.blum@linux.dev>"},{"kind":"patch","patchId":"patch:20260813082049.41209-2-thorsten.blum@linux.dev:0:0"}],"patchIds":["patch:20260813082049.41209-2-thorsten.blum@linux.dev:0:0"],"attachmentMetadata":[],"sourceOrdinal":0,"diagnostics":[]},"d25d6a9c-609e-4fa2-9b26-23cded2b58a8@app.fastmail.com":{"id":"d25d6a9c-609e-4fa2-9b26-23cded2b58a8@app.fastmail.com","messageId":"d25d6a9c-609e-4fa2-9b26-23cded2b58a8@app.fastmail.com","references":["20260813082049.41209-2-thorsten.blum@linux.dev"],"missingAncestorIds":[],"author":{"name":"Mark Pearson","address":"mpearson-lenovo@squebb.ca"},"replyTo":[],"to":[{"name":"Thorsten Blum","address":"thorsten.blum@linux.dev"},{"name":"Derek J . Clark","address":"derekjohn.clark@gmail.com"},{"name":"Hans de Goede","address":"hansg@kernel.org"},{"name":"Ilpo Järvinen","address":"ilpo.jarvinen@linux.intel.com"}],"cc":[{"name":"","address":"stable@vger.kernel.org"},{"name":"Mark Pearson","address":"markpearson@lenovo.com"},{"name":"","address":"platform-driver-x86@vger.kernel.org"},{"name":"","address":"linux-kernel@vger.kernel.org"}],"timestamp":{"raw":"2026-08-13T13:52:10.000Z","iso":"2026-08-13T13:52:10.000Z","valid":true},"subject":"Re: [PATCH v2] platform/x86: think-lmi: Fix current password length check","mailingLists":[{"id":"platform-driver-x86.vger.kernel.org","displayName":"platform-driver-x86.vger.kernel.org"}],"blocks":[{"kind":"paragraph","text":"Thanks Thorsten"},{"kind":"quote","attribution":"On Thu, Aug 13, 2026, at 4:20 AM, Thorsten Blum wrote:","lines":[{"depth":1,"text":"current_password_store() checks the password length before removing the"},{"depth":1,"text":"trailing newline, which can reject valid passwords that are exactly"},{"depth":1,"text":"->maxlen bytes long."},{"depth":1,"text":""},{"depth":1,"text":"It also passes ->maxlen to strscpy(), which truncates passwords without"},{"depth":1,"text":"a newline."},{"depth":1,"text":""},{"depth":1,"text":"Use strchrnul() to measure the password length up to the newline, then"},{"depth":1,"text":"copy that many bytes and add a trailing NUL terminator."},{"depth":1,"text":""},{"depth":1,"text":"Fixes: a40cd7ef22fb (\"platform/x86: think-lmi: Add WMI interface "},{"depth":1,"text":"support on Lenovo platforms\")"},{"depth":1,"text":"Cc: stable@vger.kernel.org"},{"depth":1,"text":"Signed-off-by: Thorsten Blum <thorsten.blum@linux.dev>"},{"depth":1,"text":"---"},{"depth":1,"text":"Changes in v2:"},{"depth":1,"text":"- Keep and reword the newline comment"},{"depth":1,"text":"- v1: "},{"depth":1,"text":"https://lore.kernel.org/r/20260810132018.156868-3-thorsten.blum@linux.dev/"},{"depth":1,"text":"---"},{"depth":1,"text":" drivers/platform/x86/lenovo/think-lmi.c | 8 ++++----"},{"depth":1,"text":" 1 file changed, 4 insertions(+), 4 deletions(-)"},{"depth":1,"text":""},{"depth":1,"text":"diff --git a/drivers/platform/x86/lenovo/think-lmi.c "},{"depth":1,"text":"b/drivers/platform/x86/lenovo/think-lmi.c"},{"depth":1,"text":"index e215e86e3db7..d0ceb6aaa69e 100644"},{"depth":1,"text":"--- a/drivers/platform/x86/lenovo/think-lmi.c"},{"depth":1,"text":"+++ b/drivers/platform/x86/lenovo/think-lmi.c"},{"depth":1,"text":"@@ -438,14 +438,14 @@ static ssize_t current_password_store(struct "},{"depth":1,"text":"kobject *kobj,"},{"depth":1,"text":" \tstruct tlmi_pwd_setting *setting = to_tlmi_pwd_setting(kobj);"},{"depth":1,"text":" \tsize_t pwdlen;"},{"depth":1,"text":""},{"depth":1,"text":"-\tpwdlen = strlen(buf);"},{"depth":1,"text":"+\t/* Strip newline; setting password won't work if one is present. */"},{"depth":1,"text":"+\tpwdlen = strchrnul(buf, '\\n') - buf;"},{"depth":1,"text":" \t/* pwdlen == 0 is allowed to clear the password */"},{"depth":1,"text":" \tif (pwdlen && ((pwdlen < setting->minlen) || (pwdlen > setting->maxlen)))"},{"depth":1,"text":" \t\treturn -EINVAL;"},{"depth":1,"text":""},{"depth":1,"text":"-\tstrscpy(setting->password, buf, setting->maxlen);"},{"depth":1,"text":"-\t/* Strip out CR if one is present, setting password won't work if it "},{"depth":1,"text":"is present */"},{"depth":1,"text":"-\tstrreplace(setting->password, '\\n', '\\0');"},{"depth":1,"text":"+\tmemcpy(setting->password, buf, pwdlen);"},{"depth":1,"text":"+\tsetting->password[pwdlen] = '\\0';"},{"depth":1,"text":" \treturn count;"},{"depth":1,"text":" }"}],"lineCount":48,"maximumDepth":1},{"kind":"paragraph","text":"Reviewed-by: Mark Pearson <mpearson-lenovo@squebb.ca>\nMark"}],"patchIds":[],"attachmentMetadata":[],"sourceOrdinal":1,"diagnostics":[],"declaredParentMessageId":"20260813082049.41209-2-thorsten.blum@linux.dev","parentId":"20260813082049.41209-2-thorsten.blum@linux.dev"}},"rootIds":["20260813082049.41209-2-thorsten.blum@linux.dev"],"childrenByParent":{"20260813082049.41209-2-thorsten.blum@linux.dev":["d25d6a9c-609e-4fa2-9b26-23cded2b58a8@app.fastmail.com"]},"chronologicalIds":["20260813082049.41209-2-thorsten.blum@linux.dev","d25d6a9c-609e-4fa2-9b26-23cded2b58a8@app.fastmail.com"],"patchSeries":[],"diagnostics":[],"patches":{"patch:20260813082049.41209-2-thorsten.blum@linux.dev:0:0":{"id":"patch:20260813082049.41209-2-thorsten.blum@linux.dev:0:0","messageId":"20260813082049.41209-2-thorsten.blum@linux.dev","subject":"[PATCH v2] platform/x86: think-lmi: Fix current password length check","commitMessage":[],"files":[{"oldPath":"drivers/platform/x86/lenovo/think-lmi.c","newPath":"drivers/platform/x86/lenovo/think-lmi.c","displayPath":"drivers/platform/x86/lenovo/think-lmi.c","status":"modified","hunks":[{"header":"@@ -438,14 +438,14 @@ static ssize_t current_password_store(struct kobject *kobj,","oldStart":438,"oldCount":14,"newStart":438,"newCount":14,"lines":[{"kind":"context","text":"\tstruct tlmi_pwd_setting *setting = to_tlmi_pwd_setting(kobj);","oldLine":438,"newLine":438},{"kind":"context","text":"\tsize_t pwdlen;","oldLine":439,"newLine":439},{"kind":"context","text":"","oldLine":440,"newLine":440},{"kind":"deletion","text":"\tpwdlen = strlen(buf);","oldLine":441},{"kind":"addition","text":"\t/* Strip newline; setting password won't work if one is present. */","newLine":441},{"kind":"addition","text":"\tpwdlen = strchrnul(buf, '\\n') - buf;","newLine":442},{"kind":"context","text":"\t/* pwdlen == 0 is allowed to clear the password */","oldLine":442,"newLine":443},{"kind":"context","text":"\tif (pwdlen && ((pwdlen < setting->minlen) || (pwdlen > setting->maxlen)))","oldLine":443,"newLine":444},{"kind":"context","text":"\t\treturn -EINVAL;","oldLine":444,"newLine":445},{"kind":"context","text":"","oldLine":445,"newLine":446},{"kind":"deletion","text":"\tstrscpy(setting->password, buf, setting->maxlen);","oldLine":446},{"kind":"deletion","text":"\t/* Strip out CR if one is present, setting password won't work if it is present */","oldLine":447},{"kind":"deletion","text":"\tstrreplace(setting->password, '\\n', '\\0');","oldLine":448},{"kind":"addition","text":"\tmemcpy(setting->password, buf, pwdlen);","newLine":447},{"kind":"addition","text":"\tsetting->password[pwdlen] = '\\0';","newLine":448},{"kind":"context","text":"\treturn count;","oldLine":449,"newLine":449},{"kind":"context","text":"}","oldLine":450,"newLine":450},{"kind":"context","text":"","oldLine":451,"newLine":451},{"kind":"metadata","text":""}]}],"binary":false}],"trailers":[],"rawText":"diff --git a/drivers/platform/x86/lenovo/think-lmi.c b/drivers/platform/x86/lenovo/think-lmi.c\nindex e215e86e3db7..d0ceb6aaa69e 100644\n--- a/drivers/platform/x86/lenovo/think-lmi.c\n+++ b/drivers/platform/x86/lenovo/think-lmi.c\n@@ -438,14 +438,14 @@ static ssize_t current_password_store(struct kobject *kobj,\n \tstruct tlmi_pwd_setting *setting = to_tlmi_pwd_setting(kobj);\n \tsize_t pwdlen;\n \n-\tpwdlen = strlen(buf);\n+\t/* Strip newline; setting password won't work if one is present. */\n+\tpwdlen = strchrnul(buf, '\\n') - buf;\n \t/* pwdlen == 0 is allowed to clear the password */\n \tif (pwdlen && ((pwdlen < setting->minlen) || (pwdlen > setting->maxlen)))\n \t\treturn -EINVAL;\n \n-\tstrscpy(setting->password, buf, setting->maxlen);\n-\t/* Strip out CR if one is present, setting password won't work if it is present */\n-\tstrreplace(setting->password, '\\n', '\\0');\n+\tmemcpy(setting->password, buf, pwdlen);\n+\tsetting->password[pwdlen] = '\\0';\n \treturn count;\n }\n \n","statistics":{"files":1,"additions":4,"deletions":4},"diagnostics":[]}}}}