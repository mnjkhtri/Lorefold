{"schemaVersion":1,"generatedAt":"2026-08-16T16:20:46.501Z","id":"0d3764a38f091f6496d337cd","canonicalUrl":"https://lore.kernel.org/r/20260802-i2c-qcom-slave-v2-0-27653118fa75%40oss.qualcomm.com/","channels":["linux-i2c"],"thread":{"schemaVersion":1,"id":"thread:lore-git:20260802-i2c-qcom-slave-v2-0-27653118fa75@oss.qualcomm.com","source":{"kind":"static-generated","canonicalThreadUrl":"https://lore.kernel.org/r/20260802-i2c-qcom-slave-v2-0-27653118fa75%40oss.qualcomm.com/","fetchedAt":"2026-08-16T16:20:46.501Z","contentDigest":"lore-git:20260802-i2c-qcom-slave-v2-0-27653118fa75@oss.qualcomm.com"},"subject":"Re: [PATCH v2 1/2] dt-bindings: i2c: Add Qualcomm I2C target controller","messages":{"f52bbc62-9e6a-4e8b-a3f5-500ea26a18a4@oss.qualcomm.com":{"id":"f52bbc62-9e6a-4e8b-a3f5-500ea26a18a4@oss.qualcomm.com","messageId":"f52bbc62-9e6a-4e8b-a3f5-500ea26a18a4@oss.qualcomm.com","references":["20260802-i2c-qcom-slave-v2-0-27653118fa75@oss.qualcomm.com","20260802-i2c-qcom-slave-v2-1-27653118fa75@oss.qualcomm.com","20260804-airborne-impala-of-proficiency-a9a8d9@quoll"],"missingAncestorIds":["20260804-airborne-impala-of-proficiency-a9a8d9@quoll","20260802-i2c-qcom-slave-v2-1-27653118fa75@oss.qualcomm.com","20260802-i2c-qcom-slave-v2-0-27653118fa75@oss.qualcomm.com"],"author":{"name":"Viken Dadhaniya","address":"viken.dadhaniya@oss.qualcomm.com"},"replyTo":[],"to":[{"name":"Krzysztof Kozlowski","address":"krzk@kernel.org"}],"cc":[{"name":"Mukesh Kumar Savaliya","address":"mukesh.savaliya@oss.qualcomm.com"},{"name":"Andi Shyti","address":"andi.shyti@kernel.org"},{"name":"Rob Herring","address":"robh@kernel.org"},{"name":"Krzysztof Kozlowski","address":"krzk+dt@kernel.org"},{"name":"Conor Dooley","address":"conor+dt@kernel.org"},{"name":"","address":"linux-arm-msm@vger.kernel.org"},{"name":"","address":"linux-i2c@vger.kernel.org"},{"name":"","address":"devicetree@vger.kernel.org"},{"name":"","address":"linux-kernel@vger.kernel.org"}],"timestamp":{"raw":"2026-08-12T18:21:34.000Z","iso":"2026-08-12T18:21:34.000Z","valid":true},"subject":"Re: [PATCH v2 1/2] dt-bindings: i2c: Add Qualcomm I2C target controller","mailingLists":[{"id":"linux-i2c.vger.kernel.org","displayName":"linux-i2c.vger.kernel.org"}],"blocks":[{"kind":"quote","attribution":"On 8/4/2026 1:14 PM, Krzysztof Kozlowski wrote:","lines":[{"depth":1,"text":"On Sun, Aug 02, 2026 at 06:43:30PM +0530, Viken Dadhaniya wrote:"},{"depth":2,"text":"QDU1000 and related Qualcomm SoCs include a dedicated I2C target"},{"depth":2,"text":"controller that operates exclusively in target mode. It is a distinct"},{"depth":2,"text":"IP from the Qualcomm I2C master controllers (GENI, QUP) with a"},{"depth":2,"text":"different register interface, so it requires its own binding."},{"depth":2,"text":""},{"depth":2,"text":"Document the MMIO region, interrupt, XO and AHB clocks, interconnect"},{"depth":2,"text":"path, and optional pinctrl states for the controller."},{"depth":2,"text":""},{"depth":2,"text":"Signed-off-by: Viken Dadhaniya <viken.dadhaniya@oss.qualcomm.com>"},{"depth":2,"text":"---"},{"depth":2,"text":" .../devicetree/bindings/i2c/qcom,i2c-target.yaml   | 84 ++++++++++++++++++++++"},{"depth":1,"text":""},{"depth":1,"text":"Filename must match compatible."}],"lineCount":14,"maximumDepth":2},{"kind":"paragraph","text":"Sure, will update it."},{"kind":"quote","lines":[{"depth":1,"text":""},{"depth":2,"text":" 1 file changed, 84 insertions(+)"},{"depth":2,"text":""},{"depth":2,"text":"diff --git a/Documentation/devicetree/bindings/i2c/qcom,i2c-target.yaml b/Documentation/devicetree/bindings/i2c/qcom,i2c-target.yaml"},{"depth":2,"text":"new file mode 100644"},{"depth":2,"text":"index 000000000000..1e34e874cc4c"},{"depth":2,"text":"--- /dev/null"},{"depth":2,"text":"+++ b/Documentation/devicetree/bindings/i2c/qcom,i2c-target.yaml"},{"depth":2,"text":"@@ -0,0 +1,84 @@"},{"depth":2,"text":"+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)"},{"depth":2,"text":"+%YAML 1.2"},{"depth":2,"text":"+---"},{"depth":2,"text":"+$id: http://devicetree.org/schemas/i2c/qcom,i2c-target.yaml#"},{"depth":2,"text":"+$schema: http://devicetree.org/meta-schemas/core.yaml#"},{"depth":2,"text":"+"},{"depth":2,"text":"+title: Qualcomm I2C Target Controller"},{"depth":2,"text":"+"},{"depth":2,"text":"+maintainers:"},{"depth":2,"text":"+  - Mukesh Kumar Savaliya <mukesh.savaliya@oss.qualcomm.com>"},{"depth":2,"text":"+  - Viken Dadhaniya <viken.dadhaniya@oss.qualcomm.com>"},{"depth":2,"text":"+"},{"depth":2,"text":"+description:"},{"depth":2,"text":"+  Dedicated hardware IP found on Qualcomm SoCs that operates exclusively"},{"depth":2,"text":"+  as an I2C target (slave) device on the bus. Supports FIFO (PIO) mode"},{"depth":2,"text":"+  for data transfer."},{"depth":2,"text":"+"},{"depth":2,"text":"+properties:"},{"depth":2,"text":"+  compatible:"},{"depth":2,"text":"+    enum:"},{"depth":2,"text":"+      - qcom,qdu1000-i2c-target"},{"depth":2,"text":"+"},{"depth":2,"text":"+  reg:"},{"depth":2,"text":"+    maxItems: 1"},{"depth":2,"text":"+"},{"depth":2,"text":"+  interrupts:"},{"depth":2,"text":"+    maxItems: 1"},{"depth":2,"text":"+"},{"depth":2,"text":"+  clocks:"},{"depth":2,"text":"+    items:"},{"depth":2,"text":"+      - description: XO reference clock"},{"depth":2,"text":"+      - description: AHB bus clock"},{"depth":2,"text":"+"},{"depth":2,"text":"+  clock-names:"},{"depth":2,"text":"+    items:"},{"depth":2,"text":"+      - const: xo"},{"depth":2,"text":"+      - const: ahb"},{"depth":2,"text":"+"},{"depth":2,"text":"+  interconnects:"},{"depth":2,"text":"+    maxItems: 1"},{"depth":2,"text":"+"},{"depth":2,"text":"+  interconnect-names:"},{"depth":2,"text":"+    const: i2c"},{"depth":1,"text":""},{"depth":1,"text":"Pretty useless name, drop the interconnect-names."}],"lineCount":54,"maximumDepth":2},{"kind":"paragraph","text":"Sure. will remove it."},{"kind":"quote","lines":[{"depth":1,"text":""},{"depth":2,"text":"+"},{"depth":2,"text":"+  pinctrl-0: true"},{"depth":2,"text":"+  pinctrl-1: true"},{"depth":2,"text":"+"},{"depth":2,"text":"+  pinctrl-names:"},{"depth":2,"text":"+    items:"},{"depth":2,"text":"+      - const: default"},{"depth":2,"text":"+      - const: sleep"},{"depth":2,"text":"+"},{"depth":2,"text":"+required:"},{"depth":2,"text":"+  - compatible"},{"depth":2,"text":"+  - reg"},{"depth":2,"text":"+  - interrupts"},{"depth":2,"text":"+  - clocks"},{"depth":2,"text":"+  - clock-names"},{"depth":2,"text":"+  - interconnects"},{"depth":2,"text":"+  - interconnect-names"},{"depth":2,"text":"+"},{"depth":2,"text":"+allOf:"},{"depth":2,"text":"+  - $ref: /schemas/i2c/i2c-controller.yaml#"},{"depth":1,"text":""},{"depth":1,"text":"This wasn't here before. Is this a controller or a target? Now I am"},{"depth":1,"text":"confused."}],"lineCount":24,"maximumDepth":2},{"kind":"paragraph","text":"It is a target. Wrong ref, will remove it."},{"kind":"quote","lines":[{"depth":1,"text":""},{"depth":2,"text":"+"},{"depth":2,"text":"+unevaluatedProperties: false"},{"depth":2,"text":"+"},{"depth":2,"text":"+examples:"},{"depth":2,"text":"+  - |"},{"depth":2,"text":"+    #include <dt-bindings/interrupt-controller/arm-gic.h>"},{"depth":2,"text":"+    #include <dt-bindings/clock/qcom,qdu1000-gcc.h>"},{"depth":2,"text":"+    #include <dt-bindings/interconnect/qcom,qdu1000-rpmh.h>"},{"depth":2,"text":"+"},{"depth":2,"text":"+    i2c@88ca000 {"},{"depth":2,"text":"+        compatible = \"qcom,qdu1000-i2c-target\";"},{"depth":2,"text":"+        reg = <0x88ca000 0x64>;"},{"depth":2,"text":"+        clocks = <&gcc GCC_SM_BUS_XO_CLK>, <&gcc GCC_SM_BUS_AHB_CLK>;"},{"depth":2,"text":"+        clock-names = \"xo\", \"ahb\";"},{"depth":2,"text":"+        interrupts = <GIC_SPI 358 IRQ_TYPE_LEVEL_HIGH>;"},{"depth":2,"text":"+        #address-cells = <1>;"},{"depth":2,"text":"+        #size-cells = <0>;"},{"depth":1,"text":""},{"depth":1,"text":"How is this valid?"},{"depth":1,"text":""},{"depth":1,"text":"What sort of children the target has? What does it do with these"},{"depth":1,"text":"children?"}],"lineCount":23,"maximumDepth":2},{"kind":"paragraph","text":"This controller is an I2C target only — it has no DT children. Will\nremove those lines."},{"kind":"quote","lines":[{"depth":1,"text":""},{"depth":2,"text":"+        interconnect-names = \"i2c\";"},{"depth":2,"text":"+        interconnects = <&gem_noc MASTER_APPSS_PROC 0 &config_noc SLAVE_SMBUS_CFG 0>;"},{"depth":2,"text":"+    };"},{"depth":2,"text":"+..."},{"depth":2,"text":""},{"depth":2,"text":"-- "},{"depth":2,"text":"2.34.1"},{"depth":2,"text":""}],"lineCount":9,"maximumDepth":2}],"patchIds":[],"attachmentMetadata":[],"sourceOrdinal":0,"diagnostics":[],"declaredParentMessageId":"20260804-airborne-impala-of-proficiency-a9a8d9@quoll"}},"rootIds":["f52bbc62-9e6a-4e8b-a3f5-500ea26a18a4@oss.qualcomm.com"],"childrenByParent":{},"chronologicalIds":["f52bbc62-9e6a-4e8b-a3f5-500ea26a18a4@oss.qualcomm.com"],"patchSeries":[],"diagnostics":[],"patches":{}}}