{"schemaVersion":1,"generatedAt":"2026-08-16T16:20:46.501Z","id":"934b6c878e148841bc714d2c","canonicalUrl":"https://lore.kernel.org/r/CABHf4aS9Lh6Q-7MykVgvEpsWW08GTo%2BMd_9U9nn5a%3DV2X6kTEw%40mail.gmail.com/","channels":["regressions"],"thread":{"schemaVersion":1,"id":"thread:lore-git:CABHf4aS9Lh6Q-7MykVgvEpsWW08GTo+Md_9U9nn5a=V2X6kTEw@mail.gmail.com","source":{"kind":"static-generated","canonicalThreadUrl":"https://lore.kernel.org/r/CABHf4aS9Lh6Q-7MykVgvEpsWW08GTo%2BMd_9U9nn5a%3DV2X6kTEw%40mail.gmail.com/","fetchedAt":"2026-08-16T16:20:46.501Z","contentDigest":"lore-git:CABHf4aS9Lh6Q-7MykVgvEpsWW08GTo+Md_9U9nn5a=V2X6kTEw@mail.gmail.com"},"subject":"Re: [REGRESSION] Dell Latitude 7390 Intel UHD 620 screen becomes extremely dim after kernel 7.x upgrade","messages":{"dba13bb0-20d3-4aba-ad70-9cc3266ff165@intel.com":{"id":"dba13bb0-20d3-4aba-ad70-9cc3266ff165@intel.com","messageId":"dba13bb0-20d3-4aba-ad70-9cc3266ff165@intel.com","references":["CABHf4aS9Lh6Q-7MykVgvEpsWW08GTo+Md_9U9nn5a=V2X6kTEw@mail.gmail.com"],"missingAncestorIds":["CABHf4aS9Lh6Q-7MykVgvEpsWW08GTo+Md_9U9nn5a=V2X6kTEw@mail.gmail.com"],"author":{"name":"Borah, Chaitanya Kumar","address":"chaitanya.kumar.borah@intel.com"},"replyTo":[],"to":[{"name":"","address":"nomorsukses@gmail.com"},{"name":"","address":"regressions@lists.linux.dev"}],"cc":[{"name":"","address":"intel-gfx@lists.freedesktop.org"}],"timestamp":{"raw":"2026-08-07T08:42:43.000Z","iso":"2026-08-07T08:42:43.000Z","valid":true},"subject":"Re: [REGRESSION] Dell Latitude 7390 Intel UHD 620 screen becomes extremely dim after kernel 7.x upgrade","mailingLists":[{"id":"regressions.lists.linux.dev","displayName":"regressions.lists.linux.dev"}],"blocks":[{"kind":"paragraph","text":"Hello,"},{"kind":"quote","attribution":"On 8/6/2026 5:13 PM, nomorsukses@gmail.com wrote:","lines":[{"depth":1,"text":"Hello Linux kernel and Intel graphics developers,"},{"depth":1,"text":"> I would like to report a kernel regression affecting the internal > display brightness on my Dell Latitude 7390 laptop."},{"depth":1,"text":"> After upgrading from Linux kernel 6.14.x to Linux kernel 7.x, the > internal laptop display becomes extremely dim immediately after boot."},{"depth":1,"text":"> The system continues to run normally, but the brightness level becomes > almost unusable."},{"depth":1,"text":"> Booting back into Linux kernel 6.14.x restores normal display brightness."},{"depth":1,"text":"Thank you for the report."}],"lineCount":6,"maximumDepth":1},{"kind":"paragraph","text":"Can you please file a bug using [1]?"},{"kind":"paragraph","text":"==\nChaitanya"},{"kind":"paragraph","text":"[1] https://drm.pages.freedesktop.org/intel-docs/how-to-file-i915-bugs.html"},{"kind":"quote","lines":[{"depth":1,"text":"Hardware information:"},{"depth":1,"text":"> Laptop:"},{"depth":1,"text":"Dell Latitude 7390"},{"depth":1,"text":"> CPU:"},{"depth":1,"text":"Intel Core i7-8650U"},{"depth":1,"text":"> GPU:"},{"depth":1,"text":"Intel UHD Graphics 620"},{"depth":1,"text":"PCI ID: 8086:5917"},{"depth":1,"text":"> Graphics driver:"},{"depth":1,"text":"i915"},{"depth":1,"text":"> Display:"},{"depth":1,"text":"Chi Mei Innolux 1920x1080 eDP panel"},{"depth":1,"text":"> BIOS:"},{"depth":1,"text":"Dell version 1.44.0"},{"depth":1,"text":"> Operating systems tested:"},{"depth":1,"text":">   *"},{"depth":1,"text":">     Ubuntu 24.04.4 LTS"},{"depth":1,"text":">   *"},{"depth":1,"text":">     Linux Mint 22.2 (based on Ubuntu 24.04)"},{"depth":1,"text":"> The same issue happens on both distributions."},{"depth":1,"text":"> Working kernel:"},{"depth":1,"text":"6.14.0-29-generic"},{"depth":1,"text":"> Problematic kernel:"},{"depth":1,"text":"7.x"},{"depth":1,"text":"> Steps to reproduce:"},{"depth":1,"text":">  1."},{"depth":1,"text":">     Install Ubuntu 24.04 or Linux Mint 22.2."},{"depth":1,"text":">  2."},{"depth":1,"text":">     Update the system to kernel 7.x."},{"depth":1,"text":">  3."},{"depth":1,"text":">     Reboot."},{"depth":1,"text":">  4."},{"depth":1,"text":">     The internal display becomes extremely dim."},{"depth":1,"text":">  5."},{"depth":1,"text":">     Boot kernel 6.14.x."},{"depth":1,"text":">  6."},{"depth":1,"text":">     Display brightness works normally again."},{"depth":1,"text":"> Additional information:"},{"depth":1,"text":">   *"},{"depth":1,"text":">     Secure Boot is disabled."},{"depth":1,"text":">   *"},{"depth":1,"text":">     The issue is reproducible."},{"depth":1,"text":">   *"},{"depth":1,"text":">     The system remains usable except for the display brightness problem."},{"depth":1,"text":">   *"},{"depth":1,"text":">     The regression appears between kernel 6.14 and kernel 7.x."},{"depth":1,"text":">   *"},{"depth":1,"text":">     The graphics driver in use is Intel i915."},{"depth":1,"text":"> This may be related to Intel i915 backlight handling or eDP panel > initialization."},{"depth":1,"text":"> I can provide dmesg logs and additional debugging information if required."},{"depth":1,"text":"> Thank you for your help."},{"depth":1,"text":"> Best regards,"},{"depth":1,"text":"PoL"},{"depth":1,"text":""}],"lineCount":54,"maximumDepth":1}],"patchIds":[],"attachmentMetadata":[],"sourceOrdinal":0,"diagnostics":[],"declaredParentMessageId":"CABHf4aS9Lh6Q-7MykVgvEpsWW08GTo+Md_9U9nn5a=V2X6kTEw@mail.gmail.com"}},"rootIds":["dba13bb0-20d3-4aba-ad70-9cc3266ff165@intel.com"],"childrenByParent":{},"chronologicalIds":["dba13bb0-20d3-4aba-ad70-9cc3266ff165@intel.com"],"patchSeries":[],"diagnostics":[],"patches":{}}}