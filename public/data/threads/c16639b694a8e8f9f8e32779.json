ch_data(&pdev->dev);"},{"depth":1,"text":"@@ -214,10 +138,6 @@ static int dw_i2c_plat_probe(struct platform_device *pdev)"},{"depth":1,"text":"  \tstruct dw_i2c_dev *dev;"},{"depth":1,"text":"  \tint irq, ret;"},{"depth":1,"text":"  > -\tret = i2c_dw_check_gpio_dependencies(device);"},{"depth":1,"text":"-\tif (ret)"},{"depth":1,"text":"-\t\treturn ret;"},{"depth":1,"text":"-"},{"depth":1,"text":"  \tirq = platform_get_irq_optional(pdev, 0);"},{"depth":1,"text":"  \tif (irq == -ENXIO)"},{"depth":1,"text":"  \t\tflags |= ACCESS_POLLING;"},{"depth":1,"text":"> base-commit: 3d6d817622b0a9721e3cc404df3469171582be13"}],"lineCount":112,"maximumDepth":1}],"patchIds":[],"attachmentMetadata":[],"sourceOrdinal":2,"diagnostics":[],"declaredParentMessageId":"20260814100719.9548-1-hardikprakash.official@gmail.com","parentId":"20260814100719.9548-1-hardikprakash.official@gmail.com"},"an-GZpgfiPJj2JsV@zenone.zhora.eu":{"id":"an-GZpgfiPJj2JsV@zenone.zhora.eu","messageId":"an-GZpgfiPJj2JsV@zenone.zhora.eu","references":["20260814100719.9548-1-hardikprakash.official@gmail.com"],"missingAncestorIds":[],"author":{"name":"Andi Shyti","address":"andi.shyti@kernel.org"},"replyTo":[],"to":[{"name":"Hardik Prakash","address":"hardikprakash.official@gmail.com"}],"cc":[{"name":"","address":"linux-i2c@vger.kernel.org"},{"name":"","address":"linux-gpio@vger.kernel.org"},{"name":"","address":"wsa@kernel.org"},{"name":"","address":"andriy.shevchenko@intel.com"},{"name":"","address":"mario.limonciello@amd.com"},{"name":"","address":"brgl@bgdev.pl"},{"name":"","address":"basavaraj.natikar@amd.com"},{"name":"","address":"linusw@kernel.org"},{"name":"","address":"nathan@kernel.org"},{"name":"","address":"chaitanya.kumar.borah@intel.com"},{"name":"","address":"linux@leemhuis.info"},{"name":"","address":"regressions@leemhuis.info"},{"name":"","address":"linux-kernel@vger.kernel.org"}],"timestamp":{"raw":"2026-08-14T21:19:51.000Z","iso":"2026-08-14T21:19:51.000Z","valid":true},"subject":"Re: [PATCH] Revert \"i2c: designware: defer probe if child GpioInt controllers are not bound\"","mailingLists":[{"id":"linux-i2c.vger.kernel.org","displayName":"linux-i2c.vger.kernel.org"}],"blocks":[{"kind":"paragraph","text":"Hi Hardik,"},{"kind":"quote","attribution":"On Fri, Aug 14, 2026 at 03:37:19PM +0530, Hardik Prakash wrote:","lines":[{"depth":1,"text":"This reverts commit 0a4bb2abc3e56d7be6e69b050c88ba52c87e22bf."},{"depth":1,"text":""},{"depth":1,"text":"The reverted commit causes a regression on ThinkPad T14s Gen 4 (AMD):"},{"depth":1,"text":"the touchpad's I2C controller fails with lost arbitration errors,"},{"depth":1,"text":"because it delays i2c-designware's probe by roughly 500ms, which"},{"depth":1,"text":"shifts the touchpad's first HID descriptor fetch into a window where"},{"depth":1,"text":"the platform's embedded controller is still acting as a secondary I2C"},{"depth":1,"text":"bus master. Debug tracing confirms the GpioInt dependency check itself"},{"depth":1,"text":"behaves correctly (it defers appropriately and confirms the GPIO"},{"depth":1,"text":"controller is bound); the arbitration failure happens roughly a"},{"depth":1,"text":"second after the check passes, when i2c_hid_acpi's own probe attempts"},{"depth":1,"text":"its first transaction."},{"depth":1,"text":""},{"depth":1,"text":"The original fix is still needed for the Lenovo Yoga 7 14AGP11"},{"depth":1,"text":"touchscreen race the commit addressed, but a corrected version will"},{"depth":1,"text":"be resubmitted once the EC bus-mastering interaction is understood"},{"depth":1,"text":"and handled properly, rather than reintroducing a different"},{"depth":1,"text":"regression on more widely-used ThinkPad hardware in the meantime."},{"depth":1,"text":""},{"depth":1,"text":"Reported-by: Thorsten Leemhuis <linux@leemhuis.info>"},{"depth":1,"text":"Closes: https://lore.kernel.org/all/b4a4eadb-282f-464c-843a-19d415a34d0c@leemhuis.info/"},{"depth":1,"text":"Signed-off-by: Hardik Prakash <hardikprakash.official@gmail.com>"}],"lineCount":22,"maximumDepth":1},{"kind":"paragraph","text":"merged to i2c/i2c-2."},{"kind":"paragraph","text":"Thanks,\nAndi"}],"patchIds":[],"attachmentMetadata":[],"sourceOrdinal":3,"diagnostics":[],"declaredParentMessageId":"20260814100719.9548-1-hardikprakash.official@gmail.com","parentId":"20260814100719.9548-1-hardikprakash.official@gmail.com"}},"rootIds":["20260814100719.9548-1-hardikprakash.official@gmail.com"],"childrenByParent":{"20260814100719.9548-1-hardikprakash.official@gmail.com":["ba1fe2d7-ac65-4665-82cc-43800fa9ed12@leemhuis.info","cda84d69-89d2-46f6-9c86-a758bf385f54@kernel.org","an-GZpgfiPJj2JsV@zenone.zhora.eu"]},"chronologicalIds":["20260814100719.9548-1-hardikprakash.official@gmail.com","ba1fe2d7-ac65-4665-82cc-43800fa9ed12@leemhuis.info","cda84d69-89d2-46f6-9c86-a758bf385f54@kernel.org","an-GZpgfiPJj2JsV@zenone.zhora.eu"],"patchSeries":[],"diagnostics":[],"patches":{"patch:20260814100719.9548-1-hardikprakash.official@gmail.com:0:0":{"id":"patch:20260814100719.9548-1-hardikprakash.official@gmail.com:0:0","messageId":"20260814100719.9548-1-hardikprakash.official@gmail.com","subject":"[PATCH] Revert \"i2c: designware: defer probe if child GpioInt controllers are not bound\"","commitMessage":[],"files":[{"oldPath":"drivers/i2c/busses/i2c-designware-platdrv.c","newPath":"drivers/i2c/busses/i2c-designware-platdrv.c","displayPath":"drivers/i2c/busses/i2c-designware-platdrv.c","status":"modified","hunks":[{"header":"@@ -8,14 +8,12 @@","oldStart":8,"oldCount":14,"newStart":8,"newCount":12,"lines":[{"kind":"context","text":" * Copyright (C) 2007 MontaVista Software Inc.","oldLine":8,"newLine":8},{"kind":"context","text":" * Copyright (C) 2009 Provigent Ltd.","oldLine":9,"newLine":9},{"kind":"context","text":" */","oldLine":10,"newLine":10},{"kind":"deletion","text":"#include <linux/acpi.h>","oldLine":11},{"kind":"context","text":"#include <linux/clk-provider.h>","oldLine":12,"newLine":11},{"kind":"context","text":"#include <linux/c