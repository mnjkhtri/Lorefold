n@marcan.st"},{"name":"Mark Kettenis","address":"kettenis@openbsd.org"},{"name":"Andi Shyti","address":"andi.shyti@kernel.org"},{"name":"Uwe Kleine-König","address":"ukleinek@kernel.org"},{"name":"Sasha Finkelstein","address":"k@chaosmail.tech"},{"name":"","address":"devicetree@vger.kernel.org"},{"name":"","address":"linux-kernel@vger.kernel.org"},{"name":"","address":"asahi@lists.linux.dev"},{"name":"","address":"linux-arm-kernel@lists.infradead.org"},{"name":"","address":"linux-gpio@vger.kernel.org"},{"name":"","address":"linux-i2c@vger.kernel.org"},{"name":"","address":"linux-pwm@vger.kernel.org"},{"name":"Krzysztof Kozlowski","address":"krzysztof.kozlowski@oss.qualcomm.com"}],"timestamp":{"raw":"2026-08-14T07:23:23.000Z","iso":"2026-08-14T07:23:23.000Z","valid":true},"subject":"Re: [PATCH v3 2/9] dt-bindings: interrupt-controller: apple,aic2: Add apple,t8132 compatible","mailingLists":[{"id":"linux-i2c.vger.kernel.org","displayName":"linux-i2c.vger.kernel.org"}],"blocks":[{"kind":"paragraph","text":"On Tue, Aug 11, 2026 at 9:37 PM Yureka Lilian <yureka@cyberchaos.dev> wrote:"},{"kind":"quote","lines":[{"depth":1,"text":"The Apple t8132 (M4) SoC uses an AIC3 as interrupt controller, same as"},{"depth":1,"text":"the M3 predecessor."},{"depth":1,"text":""},{"depth":1,"text":"Reviewed-by: Krzysztof Kozlowski <krzysztof.kozlowski@oss.qualcomm.com>"},{"depth":1,"text":"Signed-off-by: Yureka Lilian <yureka@cyberchaos.dev>"}],"lineCount":5,"maximumDepth":1},{"kind":"paragraph","text":"Reviewed-by: Linus Walleij <linusw@kernel.org>"},{"kind":"paragraph","text":"Yours,\nLinus Walleij"}],"patchIds":[],"attachmentMetadata":[],"sourceOrdinal":0,"diagnostics":[],"declaredParentMessageId":"20260811-apple-m4-initial-devicetrees-v3-2-6bf32d45ad0b@cyberchaos.dev"},"CAD++jLkf=Ko-S-iPOt7toDRBb0HAEiAZMKXOTkD2sBdt31JWbA@mail.gmail.com":{"id":"CAD++jLkf=Ko-S-iPOt7toDRBb0HAEiAZMKXOTkD2sBdt31JWbA@mail.gmail.com","messageId":"CAD++jLkf=Ko-S-iPOt7toDRBb0HAEiAZMKXOTkD2sBdt31JWbA@mail.gmail.com","references":["20260811-apple-m4-initial-devicetrees-v3-0-6bf32d45ad0b@cyberchaos.dev","20260811-apple-m4-initial-devicetrees-v3-1-6bf32d45ad0b@cyberchaos.dev"],"missingAncestorIds":["20260811-apple-m4-initial-devicetrees-v3-1-6bf32d45ad0b@cyberchaos.dev","20260811-apple-m4-initial-devicetrees-v3-0-6bf32d45ad0b@cyberchaos.dev"],"author":{"name":"Linus Walleij","address":"linusw@kernel.org"},"replyTo":[],"to":[{"name":"Yureka Lilian","address":"yureka@cyberchaos.dev"}],"cc":[{"name":"Rob Herring","address":"robh@kernel.org"},{"name":"Krzysztof Kozlowski","address":"krzk+dt@kernel.org"},{"name":"Conor Dooley","address":"conor+dt@kernel.org"},{"name":"Lorenzo Pieralisi","address":"lpieralisi@kernel.org"},{"name":"Sven Peter","address":"sven@kernel.org"},{"name":"Janne Grunau","address":"j@jannau.net"},{"name":"Neal Gompa","address":"neal@gompa.dev"},{"name":"Thomas Gleixner","address":"tglx@kernel.org"},{"name":"Radu Rendec","address":"radu@rendec.net"},{"name":"Hector Martin","address":"marcan@marcan.st"},{"name":"Mark Kettenis","address":"kettenis@openbsd.org"},{"name":"Andi Shyti","address":"andi.shyti@kernel.org"},{"name":"Uwe Kleine-König","address":"ukleinek@kernel.org"},{"name":"Sasha Finkelstein","address":"k@chaosmail.tech"},{"name":"","address":"devicetree@vger.kernel.org"},{"name":"","address":"linux-kernel@vger.kernel.org"},{"name":"","address":"asahi@lists.linux.dev"},{"name":"","address":"linux-arm-kernel@lists.infradead.org"},{"name":"","address":"linux-gpio@vger.kernel.org"},{"name":"","address":"linux-i2c@vger.kernel.org"},{"name":"","address":"linux-pwm@vger.kernel.org"},{"name":"Krzysztof Kozlowski","address":"krzysztof.kozlowski@oss.qualcomm.com"}],"timestamp":{"raw":"2026-08-14T07:23:50.000Z","iso":"2026-08-14T07:23:50.000Z","valid":true},"subject":"Re: [PATCH v3 1/9] dt-bindings: arm: cpus: Add Apple M4 CPU core compatibles","mailingLists":[{"id":"linux-i2c.vger.kernel.org","displayName":"linux-i2c.vger.kernel.org"}],"blocks":[{"kind":"paragraph","text":"On Tue, Aug 11, 2026 at 9:37 PM Yureka Lilian <yureka@cyberchaos.dev> wrote:"},{"kind":"quote","lines":[{"depth":1,"text":"The core types of the M4 SoC no longer carry individual codenames."},{"depth":1,"text":"Apple's device trees re-use the 'everest' and 'sawtooth' codenames from"},{"depth":1,"text":"the M3 generation for all later cores."},{"depth":1,"text":""},{"depth":1,"text":"Instead, we use a combination of the SoC's codename ('Donan') and the"},{"depth":1,"text":"type of core ('e' and 'p' for the efficiency and performance cores"},{"depth":1,"text":"respectively) as compatible for these cores."},{"depth":1,"text":""},{"depth":1,"text":"Acked-by: Krzysztof Kozlowski <krzysztof.kozlowski@oss.qualcomm.com>"},{"depth":1,"text":"Signed-off-by: Yureka Lilian <yureka@cyberchaos.dev>"}],"lineCount":10,"maximumDepth":1},{"kind":"paragraph","text":"Reviewed-by: Linus Walleij <linusw@kernel.org>"},{"kind":"paragraph","text":"Yours,\nLinus Walleij"}],"patchIds":[],"attachmentMetadata":[],"sourceOrdinal":1,"diagnostics":[],"declaredParentMessageId":"20260811-apple-m4-initial-devicetrees-v3-1-6bf32d45ad0b@cyberchaos.dev"},"CAD++jLkRs5m1m3Y3vBfXvxn13i-3cMXhcEWq5ScD-xbN9uta5A@mail.gmail.com":{"id":"CAD++jLkRs5m1m3Y3vBfXvxn13i-3cMXhcEWq5ScD-xbN9uta5A@mail.gmail.com","messageId":"CAD++jLkRs5m1m3Y3vBfXvxn13i-3cMXhcEWq5ScD-xbN9uta5A@mail.gmail.com","references":["20260811-apple-m4-initial-devicetrees-v3-0-6bf32d45ad0b@cyberchaos.dev","20260811-apple-m4-initial-devicetrees-v3-9-6bf32d45ad0b@cyberchaos.dev"],"missingAncestorIds":["20260811-apple-m4-initial-devicetrees-v3-9-6bf32d45ad0b@cyberchaos.dev","20260811-apple-m4-initial-devicetrees-v3-0-6bf32d45ad0b@cyberchaos.dev"],"author":{"name":"Linus Walleij","address":"linusw@kernel.org"},"replyTo":[],"to":[{"name":"Yureka Lilian","address":"yureka@cyberchaos.dev"}],"cc":[{"name":"Rob Herring","address":"robh@kernel.org"},{"name":"Krzysztof Kozlowski","address":"krzk+dt@kernel.org"},{"name":"Conor Dooley","address":"conor+dt@kernel.org"},{"name":"Lorenzo Pieralisi","address":"lpieralisi@kernel.org"},{"name":"Sven Peter","address":"sven@kernel.org"},{"name":"Janne Grunau","address":"j@jannau.net"},{"name":"Neal Gompa","address":"neal@gompa.dev"},{"name":"Thomas Gleixner","address":"tglx@kernel.org"},{"name":"Radu Rendec","address":"radu@rendec.net"},{"name":"Hector Martin","address":"marcan@marcan.st"},{"name":"Mark Kettenis","address":"kettenis@openbsd.org"},{"name":"Andi Shyti","address":"andi.shyti@kernel.org"},{"name":"Uwe Kleine-König","address":"ukleinek@kernel.org"},{"name":"Sasha Finkelstein","address":"k@chaosmail.tech"},{"name":"","address":"devicetree@vger.kernel.org"},{"name":"","address":"linux-kernel@vger.kernel.org"},{"name":"","address":"asahi@lists.linux.dev"},{"name":"","address":"linux-arm-kernel@lists.infradead.org"},{"name":"","address":"linux-gpio@vger.kernel.org"},{"name":"","address":"linux-i2c@vger.kernel.org"},{"name":"","address":"linux-pwm@vger.kernel.org"}],"timestamp":{"raw":"2026-08-14T07:24:32.000Z","iso":"2026-08-14T07:24:32.000Z","valid":true},"subject":"Re: [PATCH v3 9/9] arm64: dts: apple: Add minimal t8132 (M4) device trees","mailingLists":[{"id":"linux-i2c.vger.kernel.org","displayName":"linux-i2c.vger.kernel.org"}],"blocks":[{"kind":"paragraph","text":"On Tue, Aug 11, 2026 at 9:37 PM Yureka Lilian <yureka@cyberchaos.dev> wrote:"},{"kind":"quote","lines":[{"depth":1,"text":"Added device trees for the following devices:"},{"depth":1,"text":"- apple,j604 - MacBook Pro (14-inch, M4, 2024)"},{"depth":1,"text":"- apple,j623 - iMac (24-inch, 2x USB-C, M4, 2024)"},{"depth":1,"text":"- apple,j624 - iMac (24-inch, 4x USB-C, M4, 2024)"},{"depth":1,"text":"- apple,j713 - MacBook Air (13-inch, M4, 2025)"},{"depth":1,"text":"- apple,j715 - MacBook Air (15-inch, M4, 2025)"},{"depth":1,"text":"- apple,j773g - Mac mini (M4, 2024)"},{"depth":1,"text":""},{"depth":1,"text":"The device trees have a minimal set of devices limited to CPU cores,"},{"depth":1,"text":"interrupt controller, power states, watchdog, serial, pin controller,"},{"depth":1,"text":"i2c and framebuffer."},{"depth":1,"text":"The device trees for the notebooks add a PWM controller for the keyboard"},{"depth":1,"text":"LED illumination."},{"depth":1,"text":""},{"depth":1,"text":"Using the macOS 26.6 iBoot/firmware, the Mac mini reliably boots on a"},{"depth":1,"text":"single core using the stock kernel."},{"depth":1,"text":"Booting with smp requires avoiding the wfi and wfit instructions"},{"depth":1,"text":"in the idle loop and `delay()` respectively, since those instructions"},{"depth":1,"text":"cause a loss of architectural state on the secondary cores, and even"},{"depth":1,"text":"then boot is unreliable."},{"depth":1,"text":""},{"depth":1,"text":"Signed-off-by: Yureka Lilian <yureka@cyberchaos.dev>"}],"lineCount":22,"maximumDepth":1},{"kind":"paragraph","text":"Reviewed-by: Linus Walleij <linusw@kernel.org>"},{"kind":"paragraph","text":"Yours,\nLinus Walleij"}],"patchIds":[],"attachmentMetadata":[],"sourceOrdinal":2,"diagnostics":[],"declaredParentMessageId":"20260811-apple-m4-initial-devicetrees-v3-9-6bf32d45ad0b@cyberchaos.dev"}},"rootIds":["CAD++jL=wF3CVQB=8PJUZBUDS1zaXkucBjUQ0Rw1P+jHk1f0T1g@mail.gmail.com","CAD++jLkf=Ko-S-iPOt7toDRBb0HAEiAZMKXOTkD2sBdt31JWbA@mail.gmail.com","CAD++jLkRs5m1m3Y3vBfXvxn13i-3cMXhcEWq5ScD-xbN9uta5A@mail.gmail.com"],"childrenByParent":{},"chronologicalIds":["CAD++jL=wF3CVQB=8PJUZBUDS1zaXkucBjUQ0Rw1P+jHk1f0T1g@mail.gmail.com","CAD++jLkf=Ko-S-iPOt7toDRBb0HAEiAZMKXOTkD2sBdt31JWbA@mail.gmail.com","CAD++jLkRs5m1m3Y3vBfXvxn13i-3cMXhcEWq5ScD-xbN9uta5A@mail.gmail.com"],"patchSeries":[],"diagnostics":[],"patches":{}}}