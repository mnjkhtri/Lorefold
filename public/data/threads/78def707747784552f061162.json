2026-08-16 at 07:00 +0000, Guo Ren wrote:","lines":[{"depth":1,"text":"From: \"GUO Ren (XuanTie)\" <guoren@kernel.org>"},{"depth":1,"text":""},{"depth":1,"text":"Replace the hard-coded BITS_PER_BYTE with IPI_MAX now that the constant"},{"depth":1,"text":"is exported from riscv asm/smp.h."},{"depth":1,"text":""},{"depth":1,"text":"Signed-off-by: GUO Ren (XuanTie) <guoren@kernel.org>"},{"depth":1,"text":"---"},{"depth":1,"text":" drivers/irqchip/irq-aclint-sswi.c | 4 ++--"},{"depth":1,"text":" 1 file changed, 2 insertions(+), 2 deletions(-)"},{"depth":1,"text":""},{"depth":1,"text":"diff --git a/drivers/irqchip/irq-aclint-sswi.c b/drivers/irqchip/irq-aclint-sswi.c"},{"depth":1,"text":"index ca06efd86fa1..5e010fc401f7 100644"},{"depth":1,"text":"--- a/drivers/irqchip/irq-aclint-sswi.c"},{"depth":1,"text":"+++ b/drivers/irqchip/irq-aclint-sswi.c"},{"depth":1,"text":"@@ -138,7 +138,7 @@ static int __init aclint_sswi_probe(struct fwnode_handle *fwnode)"},{"depth":1,"text":" \t}"},{"depth":1,"text":" "},{"depth":1,"text":" \t/* Register SSWI irq and handler */"},{"depth":1,"text":"-\tvirq = ipi_mux_create(BITS_PER_BYTE, aclint_sswi_ipi_send);"},{"depth":1,"text":"+\tvirq = ipi_mux_create(IPI_MAX, aclint_sswi_ipi_send);"},{"depth":1,"text":" \tif (virq <= 0) {"},{"depth":1,"text":" \t\tpr_err(\"unable to create muxed IPIs\\n\");"},{"depth":1,"text":" \t\tirq_dispose_mapping(sswi_ipi_virq);"},{"depth":1,"text":"@@ -152,7 +152,7 @@ static int __init aclint_sswi_probe(struct fwnode_handle *fwnode)"},{"depth":1,"text":" \t\t\t  aclint_sswi_starting_cpu,"},{"depth":1,"text":" \t\t\t  aclint_sswi_dying_cpu);"},{"depth":1,"text":" "},{"depth":1,"text":"-\triscv_ipi_set_virq_range(virq, BITS_PER_BYTE);"},{"depth":1,"text":"+\triscv_ipi_set_virq_range(virq, IPI_MAX);"},{"depth":1,"text":" "},{"depth":1,"text":" \treturn 0;"},{"depth":1,"text":" }"}],"lineCount":32,"maximumDepth":1},{"kind":"paragraph","text":"Reviewed-by: Radu Rendec <radu@rendec.net>"}],"patchIds":[],"attachmentMetadata":[],"sourceOrdinal":0,"diagnostics":[],"declaredParentMessageId":"20260816070049.2097442-5-guoren@kernel.org"},"e70e9fd19e9ebaec823a8abc518bf935e36938b9.camel@rendec.net":{"id":"e70e9fd19e9ebaec823a8abc518bf935e36938b9.camel@rendec.net","messageId":"e70e9fd19e9ebaec823a8abc518bf935e36938b9.camel@rendec.net","references":["20260816070049.2097442-1-guoren@kernel.org","20260816070049.2097442-6-guoren@kernel.org"],"missingAncestorIds":["20260816070049.2097442-6-guoren@kernel.org","20260816070049.2097442-1-guoren@kernel.org"],"author":{"name":"Radu Rendec","address":"radu@rendec.net"},"replyTo":[],"to":[{"name":"Guo Ren","address":"guoren@kernel.org"},{"name":"","address":"linux-riscv@lists.infradead.org"},{"name":"","address":"linux-kernel@vger.kernel.org"}],"cc":[{"name":"","address":"palmer@dabbelt.com"},{"name":"","address":"pjw@kernel.org"},{"name":"","address":"aou@eecs.berkeley.edu"},{"name":"","address":"alex@ghiti.fr"},{"name":"","address":"tglx@kernel.org"},{"name":"","address":"daniel.lezcano@kernel.org"},{"name":"","address":"anup@brainfault.org"},{"name":"","address":"hui.wang@canonical.com"},{"name":"","address":"samuel.holland@sifive.com"}],"timestamp":{"raw":"2026-08-16T15:28:08.000Z","iso":"2026-08-16T15:28:08.000Z","valid":true},"subject":"Re: [PATCH 5/5] irqchip/imsic: Use IPI_MAX instead of IMSIC_NR_IPI","mailingLists":[{"id":"linux-kernel.vger.kernel.org","displayName":"linux-kernel.vger.kernel.org"}],"blocks":[{"kind":"quote","attribution":"On Sun, 2026-08-16 at 07:00 +0000, Guo Ren wrote:","lines":[{"depth":1,"text":"From: \"GUO Ren (XuanTie)\" <guoren@kernel.org>"},{"depth":1,"text":""},{"depth":1,"text":"IMSIC was defining its own IMSIC_NR_IPI (= 8) which happened to match"},{"depth":1,"text":"the architecture's IPI_MAX. Now that IPI_MAX is exported from riscv"},{"depth":1,"text":"asm/smp.h, use the architecture constant and drop the private define."},{"depth":1,"text":""},{"depth":1,"text":"This keeps the number of multiplexed IPIs in sync with the rest of the"},{"depth":1,"text":"RISC-V IPI infrastructure."},{"depth":1,"text":""},{"depth":1,"text":"Signed-off-by: GUO Ren (XuanTie) <guoren@kernel.org>"},{"depth":1,"text":"---"},{"depth":1,"text":" drivers/irqchip/irq-riscv-imsic-early.c | 4 ++--"},{"depth":1,"text":" drivers/irqchip/irq-riscv-imsic-state.h | 1 -"},{"depth":1,"text":" 2 files changed, 2 insertions(+), 3 deletions(-)"},{"depth":1,"text":""},{"depth":1,"text":"diff --git a/drivers/irqchip/irq-riscv-imsic-early.c b/drivers/irqchip/irq-riscv-imsic-early.c"},{"depth":1,"text":"index 12efd241ce88..823f5f2ecb3d 100644"},{"depth":1,"text":"--- a/drivers/irqchip/irq-riscv-imsic-early.c"},{"depth":1,"text":"+++ b/drivers/irqchip/irq-riscv-imsic-early.c"},{"depth":1,"text":"@@ -67,12 +67,12 @@ static int __init imsic_ipi_domain_init(void)"},{"depth":1,"text":" \t\treturn 0;"},{"depth":1,"text":" "},{"depth":1,"text":" \t/* Create IMSIC IPI multiplexing */"},{"depth":1,"text":"-\tvirq = ipi_mux_create(IMSIC_NR_IPI, imsic_ipi_send);"},{"depth":1,"text":"+\tvirq = ipi_mux_create(IPI_MAX, imsic_ipi_send);"},{"depth":1,"text":" \tif (virq <= 0)"},{"depth":1,"text":" \t\treturn virq < 0 ? virq : -ENOMEM;"},{"depth":1,"text":" "},{"depth":1,"text":" \t/* Set vIRQ range */"},{"depth":1,"text":"-\triscv_ipi_set_virq_range(virq, IMSIC_NR_IPI);"},{"depth":1,"text":"+\triscv_ipi_set_virq_range(virq, IPI_MAX);"},{"depth":1,"text":" "},{"depth":1,"text":" \t/* Announce that IMSIC is providing IPIs */"},{"depth":1,"text":" \tpr_info(\"%pfwP: providing IPIs using interrupt %d\\n\", imsic->fwnode, IMSIC_IPI_ID);"},{"depth":1,"text":"diff --git a/drivers/irqchip/irq-riscv-imsic-state.h b/drivers/irqchip/irq-riscv-imsic-state.h"},{"depth":1,"text":"index c42ee180b305..878cc192ccec 100644"},{"depth":1,"text":"--- a/drivers/irqchip/irq-riscv-imsic-state.h"},{"depth":1,"text":"+++ b/drivers/irqchip/irq-riscv-imsic-state.h"},{"depth":1,"text":"@@ -13,7 +13,6 @@"},{"depth":1,"text":" #include <linux/timer.h>"},{"depth":1,"text":" "},{"depth":1,"text":" #define IMSIC_IPI_ID\t\t\t\t1"},{"depth":1,"text":"-#define IMSIC_NR_IPI\t\t\t\t8"},{"depth":1,"text":" "},{"depth":1,"text":" struct imsic_vector {"},{"depth":1,"text":" \t/* Fixed details of the vector */"}],"lineCount":46,"maximumDepth":1},{"kind":"paragraph","text":"Reviewed-by: Radu Rendec <radu@rendec.net>"}],"patchIds":[],"attachmentMetadata":[],"sourceOrdinal":1,"diagnostics":[],"declaredParentMessageId":"20260816070049.2097442-6-guoren@kernel.org"}},"rootIds":["f54332aa3683bfb5e3eb340c9a7d94cc1f5ffe4c.camel@rendec.net","e70e9fd19e9ebaec823a8abc518bf935e36938b9.camel@rendec.net"],"childrenByParent":{},"chronologicalIds":["f54332aa3683bfb5e3eb340c9a7d94cc1f5ffe4c.camel@rendec.net","e70e9fd19e9ebaec823a8abc518bf935e36938b9.camel@rendec.net"],"patchSeries":[],"diagnostics":[],"patches":{}}}