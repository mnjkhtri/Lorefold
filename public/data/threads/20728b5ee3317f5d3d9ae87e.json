ain_register(dev,"},{"depth":1,"text":"> +\t\t\t\t\t\t     &uniwill_wmi_chain_head,"},{"depth":1,"text":"> +\t\t\t\t\t\t     nb);"},{"depth":1,"text":">  }"},{"depth":1,"text":""},{"depth":1,"text":"I'd remove this function and replace calls to it directly by devm_blocking_notifier_chain_register()."}],"lineCount":16,"maximumDepth":1},{"kind":"paragraph","text":"uniwill_wmi_chain_head is static in uniwill-wmi.c and the caller is in\nuniwill-acpi.c. The wrapper encapsulates access to this module-private\nnotifier head - removing it would require exposing the variable through\nthe header, which breaks the current abstraction."},{"kind":"paragraph","text":"I'd prefer to keep the wrapper as-is."},{"kind":"paragraph","text":"Best regards\nEliav"}],"patchIds":[],"attachmentMetadata":[],"sourceOrdinal":0,"diagnostics":[],"declaredParentMessageId":"anlSAqWxS7boyJBT@monoceros"},"aoFcyiofUhsetEiq@monoceros":{"id":"aoFcyiofUhsetEiq@monoceros","messageId":"aoFcyiofUhsetEiq@monoceros","references":["20260726101739.33170-1-farbere@amazon.com","20260726101739.33170-11-farbere@amazon.com","anlSAqWxS7boyJBT@monoceros","MN0PR18MB5870444BD9375EF4F7131851C6D82@MN0PR18MB5870.namprd18.prod.outlook.com"],"missingAncestorIds":[],"author":{"name":"Uwe Kleine-König","address":"ukleinek@kernel.org"},"replyTo":[],"to":[{"name":"Farber, Eliav","address":"farbere@amazon.com"}],"cc":[{"name":"","address":"rafael@kernel.org"},{"name":"","address":"tony.luck@intel.com"},{"name":"","address":"bp@alien8.de"},{"name":"","address":"guohanjun@huawei.com"},{"name":"","address":"mchehab@kernel.org"},{"name":"","address":"xueshuai@linux.alibaba.com"},{"name":"","address":"lenb@kernel.org"},{"name":"","address":"laurent.pinchart@ideasonboard.com"},{"name":"","address":"linusw@kernel.org"},{"name":"","address":"brgl@kernel.org"},{"name":"","address":"orsonzhai@gmail.com"},{"name":"","address":"baolin.wang@linux.alibaba.com"},{"name":"","address":"zhang.lyra@gmail.com"},{"name":"","address":"jic23@kernel.org"