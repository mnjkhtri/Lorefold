{"schemaVersion":1,"generatedAt":"2026-08-16T16:20:46.501Z","id":"36ee9092ecb2c72aa9459cb0","canonicalUrl":"https://lore.kernel.org/r/20260814073851.3797172-1-jaeyoon.jung%40lge.com/","channels":["openembedded-core"],"thread":{"schemaVersion":1,"id":"thread:lore-git:20260814073851.3797172-1-jaeyoon.jung@lge.com","source":{"kind":"static-generated","canonicalThreadUrl":"https://lore.kernel.org/r/20260814073851.3797172-1-jaeyoon.jung%40lge.com/","fetchedAt":"2026-08-16T16:20:46.501Z","contentDigest":"lore-git:20260814073851.3797172-1-jaeyoon.jung@lge.com"},"subject":"[PATCH] openssl: use nonarch_libdir for openssldir","messages":{"20260814073851.3797172-1-jaeyoon.jung@lge.com":{"id":"20260814073851.3797172-1-jaeyoon.jung@lge.com","messageId":"20260814073851.3797172-1-jaeyoon.jung@lge.com","references":[],"missingAncestorIds":[],"author":{"name":"","address":"jaeyoon.jung@lge.com"},"replyTo":[],"to":[{"name":"","address":"openembedded-core@lists.openembedded.org"}],"cc":[{"name":"Jaeyoon Jung","address":"jaeyoon.jung@lge.com"}],"timestamp":{"raw":"2026-08-14T07:38:51.000Z","iso":"2026-08-14T07:38:51.000Z","valid":true},"subject":"[PATCH] openssl: use nonarch_libdir for openssldir","mailingLists":[{"id":"openembedded-core.lists.openembedded.org","displayName":"openembedded-core.lists.openembedded.org"}],"blocks":[{"kind":"code","text":"From: Jaeyoon Jung <jaeyoon.jung@lge.com>"},{"kind":"paragraph","text":"Set openssldir to ${nonarch_libdir}/ssl-3 instead of ${libdir}/ssl-3\nsince files in this directory are architecture-independent."},{"kind":"paragraph","text":"Signed-off-by: Jaeyoon Jung <jaeyoon.jung@lge.com>"},{"kind":"patch","patchId":"patch:20260814073851.3797172-1-jaeyoon.jung@lge.com:0:0"}],"patchIds":["patch:20260814073851.3797172-1-jaeyoon.jung@lge.com:0:0"],"attachmentMetadata":[],"sourceOrdinal":0,"diagnostics":[]},"CANNYZj_4x7HQHqDbqtSHVvxEfFLEjFz3dwFo-5cSPsxBCPY5Dw@mail.gmail.com":{"id":"CANNYZj_4x7HQHqDbqtSHVvxEfFLEjFz3dwFo-5cSPsxBCPY5Dw@mail.gmail.com","messageId":"CANNYZj_4x7HQHqDbqtSHVvxEfFLEjFz3dwFo-5cSPsxBCPY5Dw@mail.gmail.com","references":["20260814073851.3797172-1-jaeyoon.jung@lge.com"],"missingAncestorIds":[],"author":{"name":"Alexander Kanavin","address":"alex.kanavin@gmail.com"},"replyTo":[],"to":[{"name":"","address":"jaeyoon.jung@lge.com"}],"cc":[{"name":"","address":"openembedded-core@lists.openembedded.org"}],"timestamp":{"raw":"2026-08-14T11:19:16.000Z","iso":"2026-08-14T11:19:16.000Z","valid":true},"subject":"Re: [OE-core] [PATCH] openssl: use nonarch_libdir for openssldir","mailingLists":[{"id":"openembedded-core.lists.openembedded.org","displayName":"openembedded-core.lists.openembedded.org"}],"blocks":[{"kind":"paragraph","text":"I'm not sure. They are not binaries, but that does not mean they are\narchitecture independent, as they may contain settings for the\nparticular build of openssl, and in multilib setup those do need to go\nto a architecture-specific directory to avoid installation conflicts.\nCan you set up multilib and confirm that both lib32 and lib64 files\nare identical?"},{"kind":"paragraph","text":"Alex"},{"kind":"paragraph","text":"On Fri, 14 Aug 2026 at 09:39, Jaeyoon Jung (LGE) via\nlists.openembedded.org <jaeyoon.jung=lge.com@lists.openembedded.org>\nwrote:"},{"kind":"quote","lines":[{"depth":1,"text":""},{"depth":1,"text":"From: Jaeyoon Jung <jaeyoon.jung@lge.com>"},{"depth":1,"text":""},{"depth":1,"text":"Set openssldir to ${nonarch_libdir}/ssl-3 instead of ${libdir}/ssl-3"},{"depth":1,"text":"since files in this directory are architecture-independent."},{"depth":1,"text":""},{"depth":1,"text":"Signed-off-by: Jaeyoon Jung <jaeyoon.jung@lge.com>"},{"depth":1,"text":"---"},{"depth":1,"text":" .../openssl/openssl_3.5.7.bb                  | 28 +++++++++----------"},{"depth":1,"text":" 1 file changed, 14 insertions(+), 14 deletions(-)"},{"depth":1,"text":""},{"depth":1,"text":"diff --git a/meta/recipes-connectivity/openssl/openssl_3.5.7.bb b/meta/recipes-connectivity/openssl/openssl_3.5.7.bb"},{"depth":1,"text":"index b95c734f1d..2dd23c9da0 100644"},{"depth":1,"text":"--- a/meta/recipes-connectivity/openssl/openssl_3.5.7.bb"},{"depth":1,"text":"+++ b/meta/recipes-connectivity/openssl/openssl_3.5.7.bb"},{"depth":1,"text":"@@ -153,7 +153,7 @@ do_configure () {"},{"depth":1,"text":"        PERLEXTERNAL=\"$(realpath ${S}/external/perl/Text-Template-*/lib)\""},{"depth":1,"text":"        test -d \"$PERLEXTERNAL\" || bberror \"PERLEXTERNAL '$PERLEXTERNAL' not found!\""},{"depth":1,"text":"        HASHBANGPERL=\"/usr/bin/env perl\" PERL=perl PERL5LIB=\"$PERLEXTERNAL\" \\"},{"depth":1,"text":"-       perl ${S}/Configure ${EXTRA_OECONF} ${PACKAGECONFIG_CONFARGS} ${DEPRECATED_CRYPTO_FLAGS} --prefix=${prefix} --openssldir=${libdir}/ssl-3 --libdir=${baselib} $target"},{"depth":1,"text":"+       perl ${S}/Configure ${EXTRA_OECONF} ${PACKAGECONFIG_CONFARGS} ${DEPRECATED_CRYPTO_FLAGS} --prefix=${prefix} --openssldir=${nonarch_libdir}/ssl-3 --libdir=${baselib} $target"},{"depth":1,"text":"        perl ${B}/configdata.pm --dump"},{"depth":1,"text":" }"},{"depth":1,"text":""},{"depth":1,"text":"@@ -175,20 +175,20 @@ do_install () {"},{"depth":1,"text":"        # Create SSL structure for packages such as ca-certificates which"},{"depth":1,"text":"        # contain hard-coded paths to /etc/ssl. Debian does the same."},{"depth":1,"text":"        install -d ${D}${sysconfdir}/ssl"},{"depth":1,"text":"-       mv ${D}${libdir}/ssl-3/certs \\"},{"depth":1,"text":"-          ${D}${libdir}/ssl-3/private \\"},{"depth":1,"text":"-          ${D}${libdir}/ssl-3/openssl.cnf \\"},{"depth":1,"text":"+       mv ${D}${nonarch_libdir}/ssl-3/certs \\"},{"depth":1,"text":"+          ${D}${nonarch_libdir}/ssl-3/private \\"},{"depth":1,"text":"+          ${D}${nonarch_libdir}/ssl-3/openssl.cnf \\"},{"depth":1,"text":"           ${D}${sysconfdir}/ssl/"},{"depth":1,"text":""},{"depth":1,"text":"        # Although absolute symlinks would be OK for the target, they become"},{"depth":1,"text":"        # invalid if native or nativesdk are relocated from sstate."},{"depth":1,"text":"-       ln -sf ${@oe.path.relative('${libdir}/ssl-3', '${sysconfdir}/ssl/certs')} ${D}${libdir}/ssl-3/certs"},{"depth":1,"text":"-       ln -sf ${@oe.path.relative('${libdir}/ssl-3', '${sysconfdir}/ssl/private')} ${D}${libdir}/ssl-3/private"},{"depth":1,"text":"-       ln -sf ${@oe.path.relative('${libdir}/ssl-3', '${sysconfdir}/ssl/openssl.cnf')} ${D}${libdir}/ssl-3/openssl.cnf"},{"depth":1,"text":"+       ln -sf ${@oe.path.relative('${nonarch_libdir}/ssl-3', '${sysconfdir}/ssl/certs')} ${D}${nonarch_libdir}/ssl-3/certs"},{"depth":1,"text":"+       ln -sf ${@oe.path.relative('${nonarch_libdir}/ssl-3', '${sysconfdir}/ssl/private')} ${D}${nonarch_libdir}/ssl-3/private"},{"depth":1,"text":"+       ln -sf ${@oe.path.relative('${nonarch_libdir}/ssl-3', '${sysconfdir}/ssl/openssl.cnf')} ${D}${nonarch_libdir}/ssl-3/openssl.cnf"},{"depth":1,"text":""},{"depth":1,"text":"        # Generate fipsmodule.cnf in pkg_postinst_ontarget"},{"depth":1,"text":"        if ${@bb.utils.contains('PACKAGECONFIG', 'fips', 'true', 'false', d)}; then"},{"depth":1,"text":"-               rm -f ${D}${libdir}/ssl-3/fipsmodule.cnf"},{"depth":1,"text":"+               rm -f ${D}${nonarch_libdir}/ssl-3/fipsmodule.cnf"},{"depth":1,"text":"        fi"},{"depth":1,"text":" }"},{"depth":1,"text":""},{"depth":1,"text":"@@ -201,9 +201,9 @@ do_install:append:class-target () {"},{"depth":1,"text":""},{"depth":1,"text":" do_install:append:class-native () {"},{"depth":1,"text":"        create_wrapper ${D}${bindir}/openssl \\"},{"depth":1,"text":"-           OPENSSL_CONF=\\${OPENSSL_CONF:-${libdir}/ssl-3/openssl.cnf} \\"},{"depth":1,"text":"-           SSL_CERT_DIR=\\${SSL_CERT_DIR:-${libdir}/ssl-3/certs} \\"},{"depth":1,"text":"-           SSL_CERT_FILE=\\${SSL_CERT_FILE:-${libdir}/ssl-3/cert.pem} \\"},{"depth":1,"text":"+           OPENSSL_CONF=\\${OPENSSL_CONF:-${nonarch_libdir}/ssl-3/openssl.cnf} \\"},{"depth":1,"text":"+           SSL_CERT_DIR=\\${SSL_CERT_DIR:-${nonarch_libdir}/ssl-3/certs} \\"},{"depth":1,"text":"+           SSL_CERT_FILE=\\${SSL_CERT_FILE:-${nonarch_libdir}/ssl-3/cert.pem} \\"},{"depth":1,"text":"            OPENSSL_ENGINES=\\${OPENSSL_ENGINES:-${libdir}/engines-3} \\"},{"depth":1,"text":"            OPENSSL_MODULES=\\${OPENSSL_MODULES:-${libdir}/ossl-modules}"},{"depth":1,"text":""},{"depth":1,"text":"@@ -275,15 +275,15 @@ PACKAGES =+ \"libcrypto libssl openssl-conf ${PN}-engines ${PN}-misc ${PN}-ossl-m"},{"depth":1,"text":" FILES:libcrypto = \"${libdir}/libcrypto${SOLIBS}\""},{"depth":1,"text":" FILES:libssl = \"${libdir}/libssl${SOLIBS}\""},{"depth":1,"text":" FILES:openssl-conf = \"${sysconfdir}/ssl/openssl.cnf* \\"},{"depth":1,"text":"-                      ${libdir}/ssl-3/openssl.cnf* \\"},{"depth":1,"text":"+                      ${nonarch_libdir}/ssl-3/openssl.cnf* \\"},{"depth":1,"text":"                       \""},{"depth":1,"text":" FILES:${PN}-engines = \"${libdir}/engines-3\""},{"depth":1,"text":" # ${prefix} comes from what we pass into --prefix at configure time (which is used for INSTALLTOP)"},{"depth":1,"text":" FILES:${PN}-engines:append:mingw32:class-nativesdk = \" ${prefix}${libdir}/engines-3\""},{"depth":1,"text":"-FILES:${PN}-misc = \"${libdir}/ssl-3/misc ${bindir}/c_rehash\""},{"depth":1,"text":"+FILES:${PN}-misc = \"${nonarch_libdir}/ssl-3/misc ${bindir}/c_rehash\""},{"depth":1,"text":" FILES:${PN}-ossl-module-legacy = \"${libdir}/ossl-modules/legacy.so\""},{"depth":1,"text":" FILES:${PN}-ossl-module-fips = \"${libdir}/ossl-modules/fips.so\""},{"depth":1,"text":"-FILES:${PN} =+ \"${libdir}/ssl-3/* ${libdir}/ossl-modules/\""},{"depth":1,"text":"+FILES:${PN} =+ \"${nonarch_libdir}/ssl-3/* ${libdir}/ossl-modules/\""},{"depth":1,"text":" FILES:${PN}:append:class-nativesdk = \" ${SDKPATHNATIVE}/environment-setup.d/openssl.sh\""},{"depth":1,"text":""},{"depth":1,"text":" CONFFILES:openssl-conf = \"${sysconfdir}/ssl/openssl.cnf\""},{