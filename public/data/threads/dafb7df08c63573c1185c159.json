{"schemaVersion":1,"generatedAt":"2026-08-16T16:20:46.501Z","id":"dafb7df08c63573c1185c159","canonicalUrl":"https://lore.kernel.org/r/20260812113303.106965-1-nicourced%40altlinux.org/","channels":["platform-driver-x86"],"thread":{"schemaVersion":1,"id":"thread:lore-git:20260812113303.106965-1-nicourced@altlinux.org","source":{"kind":"static-generated","canonicalThreadUrl":"https://lore.kernel.org/r/20260812113303.106965-1-nicourced%40altlinux.org/","fetchedAt":"2026-08-16T16:20:46.501Z","contentDigest":"lore-git:20260812113303.106965-1-nicourced@altlinux.org"},"subject":"[PATCH] platform/x86/hp/hp-wmi: Add periodic tablet mode poll","messages":{"20260812113303.106965-1-nicourced@altlinux.org":{"id":"20260812113303.106965-1-nicourced@altlinux.org","messageId":"20260812113303.106965-1-nicourced@altlinux.org","references":[],"missingAncestorIds":[],"author":{"name":"","address":"nicourced@altlinux.org"},"replyTo":[],"to":[{"name":"","address":"hansg@kernel.org"},{"name":"","address":"ilpo.jarvinen@linux.intel.com"}],"cc":[{"name":"","address":"krishna.chomal108@gmail.com"},{"name":"","address":"emreleno@gmail.com"},{"name":"","address":"edip@medip.dev"},{"name":"","address":"platform-driver-x86@vger.kernel.org"},{"name":"","address":"linux-kernel@vger.kernel.org"},{"name":"Ilya Mukhamadeev","address":"nicourced@altlinux.org"}],"timestamp":{"raw":"2026-08-12T11:33:03.000Z","iso":"2026-08-12T11:33:03.000Z","valid":true},"subject":"[PATCH] platform/x86/hp/hp-wmi: Add periodic tablet mode poll","mailingLists":[{"id":"platform-driver-x86.vger.kernel.org","displayName":"platform-driver-x86.vger.kernel.org"}],"blocks":[{"kind":"code","text":"From: Ilya Mukhamadeev <nicourced@altlinux.org>"},{"kind":"paragraph","text":"Some HP convertible laptops (e.g., ProBook x360 series) do not generate\nACPI events when switching between laptop and tablet mode, causing the\ninput subsystem to never receive SW_TABLET_MODE notifications."},{"kind":"paragraph","text":"Add a periodic delayed work that polls the tablet mode state every\nsecond and reports changes via input_report_switch(). Track the last\nknown state to avoid sending duplicate events, and clean up the work\nqueue on module removal."},{"kind":"patch","patchId":"patch:20260812113303.106965-1-nicourced@altlinux.org:0:0"}],"patchIds":["patch:20260812113303.106965-1-nicourced@altlinux.org:0:0"],"attachmentMetadata":[],"sourceOrdinal":0,"diagnostics":[]}},"rootIds":["20260812113303.106965-1-nicourced@altlinux.org"],"childrenByParent":{},"chronologicalIds":["20260812113303.106965-1-nicourced@altlinux.org"],"patchSeries":[],"diagnostics":[],"patches":{"patch:20260812113303.106965-1-nicourced@altlinux.org:0:0":{"id":"patch:20260812113303.106965-1-nicourced@altlinux.org:0:0","messageId":"20260812113303.106965-1-nicourced@altlinux.org","subject":"[PATCH] platform/x86/hp/hp-wmi: Add periodic tablet mode poll","commitMessage":[],"files":[{"oldPath":"drivers/platform/x86/hp/hp-wmi.c","newPath":"drivers/platform/x86/hp/hp-wmi.c","displayPath":"drivers/platform/x86/hp/hp-wmi.c","status":"modified","hunks":[{"header":"@@ -460,6 +460,8 @@ static struct notifier_block platform_power_source_nb;","oldStart":460,"oldCount":6,"newStart":460,"newCount":8,"lines":[{"kind":"context","text":"static enum platform_profile_option active_platform_profile;","oldLine":460,"newLine":460},{"kind":"context","text":"static bool platform_profile_support;","oldLine":461,"newLine":461},{"kind":"context","text":"static bool zero_insize_support;","oldLine":462,"newLine":462},{"kind":"addition","text":"static int last_tablet_state = -1;","newLine":463},{"kind":"addition","text":"static struct delayed_work tablet_mode_work;","newLine":464},{"kind":"context","text":"","oldLine":463,"newLine":465},{"kind":"context","text":"static struct rfkill *wifi_rfkill;","oldLine":464,"newLine":466},{"kind":"context","text":"static struct rfkill *bluetooth_rfkill;","oldLine":465,"newLine":467}]},{"header":"@@ -1176,9 +1178,13 @@ static void hp_wmi_notify(union acpi_object *obj, void *context)","oldStart":1176,"oldCount":9,"newStart":1178,"newCount":13,"lines":[{"kind":"context","text":"\t\tif (test_bit(SW_DOCK, hp_wmi_input_dev->swbit))","oldLine":1176,"newLine":1178},{"kind":"context","text":"\t\t\tinput_report_switch(hp_wmi_input_dev, SW_DOCK,","oldLine":1177,"newLine":1179},{"kind":"context","text":"\t\t\t\t\t    hp_wmi_get_dock_state());","oldLine":1178,"newLine":1180},{"kind":"deletion","text":"\t\tif (test_bit(SW_TABLET_MODE, hp_wmi_input_dev->swbit))","oldLine":1179},{"kind":"deletion","text":"\t\t\tinput_report_switch(hp_wmi_input_dev, SW_TABLET_MODE,","oldLine":1180},{"kind":"deletion","text":"\t\t\t\t\t    hp_wmi_get_tablet_mode());","oldLine":1181},{"kind":"addition","text":"\t\tif (test_bit(SW_TABLET_MODE, hp_wmi_input_dev->swbit)) {","newLine":1181},{"kind":"addition","text":"\t\t\tint tablet = hp_wmi_get_tablet_mode();","newLine":1182},{"kind":"addition","text":"\t\t\tif (tablet >= 0) {","newLine":1183},{"kind":"addition","text":"\t\t\t\tlast_tablet_state = tablet;","newLine":1184},{"kind":"addition","text":"\t\t\t\tinput_report_switch(hp_wmi_input_dev, SW_TABLET_MODE, tablet);","newLine":1185},{"kind":"addition","text":"\t\t\t}","newLine":1186},{"kind":"addition","text":"\t\t}","newLine":1187},{"kind":"context","text":"\t\tinput_sync(hp_wmi_input_dev);","oldLine":1182,"newLine":1188},{"kind":"context","text":"\t\tbreak;","oldLine":1183,"newLine":1189},{"kind":"context","text":"\tcase HPWMI_PARK_HDD:","oldLine":1184,"newLine":1190}]},{"header":"@@ -1271,6 +1277,24 @@ static void hp_wmi_notify(union acpi_object *obj, void *context)","oldStart":1271,"oldCount":6,"newStart":1277,"newCount":24,"lines":[{"kind":"context","text":"\t}","oldLine":1271,"newLine":1277},{"kind":"context","text":"}","oldLine":1272,"newLine":1278},{"kind":"context","text":"","oldLine":1273,"newLine":1279},{"kind":"addition","text":"/*","newLine":1280},{"kind":"addition","text":" * Periodically poll tablet mode state and send input events if changed.","newLine":1281},{"kind":"addition","text":" * This works around missing ACPI events on some HP laptops.","newLine":1282},{"kind":"addition","text":" */","newLine":1283},{"kind":"addition","text":"static void hp_wmi_tablet_mode_work_handler(struct work_struct *work)","newLine":1284},{"kind":"addition","text":"{","newLine":1285},{"kind":"addition","text":"\tint cur = hp_wmi_get_tablet_mode();","newLine":1286},{"kind":"addition","text":"\tif (cur >= 0 && cur != last_tablet_state) {","newLine":1287},{"kind":"addition","text":"\t\tlast_tablet_state = cur;","newLine":1288},{"kind":"addition","text":"\t\tif (hp_wmi_input_dev && test_bit(SW_TABLET_MODE, hp_wmi_input_dev->swbit)) {","newLine":1289},{"kind":"addition","text":"\t\t\tinput_report_switch(hp_wmi_input_dev, SW_TABLET_MODE, cur);","newLine":1290},{"kind":"addition","text":"\t\t\tinput_sync(hp_wmi_input_dev);","newLine":1291},{"kind":"addition","text":"\t\t\tpr_debug(\"Tablet mode changed to %d\\n\", cur);","newLine":1292},{"kind":"addition","text":"\t\t}","newLine":1293},{"kind":"addition","text":"\t}","newLine":1294},{"kind":"addition","text":"\tschedule_delayed_work(&tablet_mode_work, msecs_to_jiffies(1000));","newLine":1295},{"kind":"addition","text":"}","newLine":1296},{"kind":"addition","text":"","newLine":1297},{"kind":"context","text":"static int __init hp_wmi_input_setup(void)","oldLine":1274,"newLine":1298},{"kind":"context","text":"{","oldLine":1275,"newLine":1299},{"kind":"context","text":"\tacpi_status status;","oldLine":1276,"newLine":1300}]},{"header":"@@ -1298,6 +1322,9 @@ static int __init hp_wmi_input_setup(void)","oldStart":1298,"oldCount":6,"newStart":1322,"newCount":9,"lines":[{"kind":"context","text":"\tif (!(val < 0)) {","oldLine":1298,"newLine":1322},{"kind":"context","text":"\t\t__set_bit(SW_TABLET_MODE, hp_wmi_input_dev->swbit);","oldLine":1299,"newLine":1323},{"kind":"context","text":"\t\tinput_report_switch(hp_wmi_input_dev, SW_TABLET_MODE, val);","oldLine":1300,"newLine":1324},{"kind":"addition","text":"\t\tlast_tablet_state = val;","newLine":1325},{"kind":"addition","text":"\t\tINIT_DELAYED_WORK(&tablet_mode_work, hp_wmi_tablet_mode_work_handler);","newLine":1326},{"kind":"addition","text":"\t\tschedule_delayed_work(&tablet_mode_work, msecs_to_jiffies(1000));","newLine":1327},{"kind":"context","text":"\t}","oldLine":1301,"newLine":1328},{"kind":"context","text":"","oldLine":1302,"newLine":1329},{"kind":"context","text":"\terr = sparse_keymap_setup(hp_wmi_input_dev, hp_wmi_keymap, NULL);","oldLine":1303,"newLine":1330}]},{"header":"@@ -1331,6 +1358,8 @@ static int __init hp_wmi_input_setup(void)","oldStart":1331,"oldCount":6,"newStart":1358,"newCount":8,"lines":[{"kind":"context","text":"","oldLine":1331,"newLine":1358},{"kind":"context","text":"static void hp_wmi_input_destroy(void)","oldLine":1332,"newLine":1359},{"kind":"context","text":"{","oldLine":1333,"newLine":1360},{"kind":"addition","text":"\tcancel_delayed_work_sync(&tablet_mode_work);","newLine":1361},{"kind":"addition","text":"\tlast_tablet_state = -1;","newLine":1362},{"kind":"context","text":"\twmi_remove_notify_handler(HPWMI_EVENT_GUID);","oldLine":1334,"newLine":1363},{"kind":"context","text":"\tinput_unregister_device(hp_wmi_input_dev);","oldLine":1335,"newLine":1364},{"kind":"context","text":"}","oldLine":1336,"newLine":1365},{"kind":"deletion","text":"- ","oldLine":1337},{"kind":"metadata","text":"2.50.1"},{"kind":"metadata","text":""},{"kind":"metadata","text":""}]}],"binary":false}],"trailers":[],"rawText":"diff --git a/drivers/platform/x86/hp/hp-wmi.c b/drivers/platform/x86/hp/hp-wmi.c\nindex 8ba286ed8721..5fbfdde3291a 100644\n--- a/drivers/platform/x86/hp/hp-wmi.c\n+++ b/drivers/platform/x86/hp/hp-wmi.c\n@@ -460,6 +460,8 @@ static struct notifier_block platform_power_source_nb;\n static enum platform_profile_option active_platform_profile;\n static bool platform_profile_support;\n static bool zero_insize_support;\n+static int last_tablet_state = -1;\n+static struct delayed_work tablet_mode_work;\n \n static struct rfkill *wifi_rfkill;\n static struct rfkill *bluetooth_rfkill;\n@@ -1176,9 +1178,13 @@ static void hp_wmi_notify(union acpi_object *obj, void *context)\n \t\tif (test_bit(SW_DOCK, hp_wmi_input_dev->swbit))\n \t\t\tinput_report_switch(hp_wmi_input_dev, SW_DOCK,\n \t\t\t\t\t    hp_wmi_get_dock_state());\n-\t\tif (test_bit(SW_TABLET_MODE, hp_wmi_input_dev->swbit))\n-\t\t\tinput_report_switch(hp_wmi_input_dev, SW_TABLET_MODE,\n-\t\t\t\t\t    hp_wmi_get_tablet_mode());\n+\t\tif (test_bit(SW_TABLET_MODE, hp_wmi_input_dev->swbit)) {\n+\t\t\tint tablet = hp_wmi_get_tablet_mode();\n+\t\t\tif (tablet >= 0) {\n+\t\t\t\tlast_tablet_state = tablet;\n+\t\t\t\tinput_report_switch(hp_wmi_input_dev, SW_TABLET_MODE, tablet);\n+\t\t\t}\n+\t\t}\n \t\tinput_sync(hp_wmi_input_dev);\n \t\tbreak;\n \tcase HPWMI_PARK_HDD:\n@@ -1271,6 +1277,24 @@ static void hp_wmi_notify(union acpi_object *obj, void *context)\n \t}\n }\n \n+/*\n+ * Periodically poll tablet mode state and send input events if changed.\n+ * This works around missing ACPI events on some HP laptops.\n+ */\n+static void hp_wmi_tablet_mode_work_handler(struct work_struct *work)\n+{\n+\tint cur = hp_wmi_get_tablet_mode();\n+\tif (cur >= 0 && cur != last_tablet_state) {\n+\t\tlast_tablet_state = cur;\n+\t\tif (hp_wmi_input_dev && test_bit(SW_TABLET_MODE, hp_wmi_input_dev->swbit)) {\n+\t\t\tinput_report_switch(hp_wmi_input_dev, SW_TABLET_MODE, cur);\n+\t\t\tinput_sync(hp_wmi_input_dev);\n+\t\t\tpr_debug(\"Tablet mode changed to %d\\n\", cur);\n+\t\t}\n+\t}\n+\tschedule_delayed_work(&tablet_mode_work, msecs_to_jiffies(1000));\n+}\n+\n static int __init hp_wmi_input_setup(void)\n {\n \tacpi_status status;\n@@ -1298,6 +1322,9 @@ static int __init hp_wmi_input_setup(void)\n \tif (!(val < 0)) {\n \t\t__set_bit(SW_TABLET_MODE, hp_wmi_input_dev->swbit);\n \t\tinput_report_switch(hp_wmi_input_dev, SW_TABLET_MODE, val);\n+\t\tlast_tablet_state = val;\n+\t\tINIT_DELAYED_WORK(&tablet_mode_work, hp_wmi_tablet_mode_work_handler);\n+\t\tschedule_delayed_work(&tablet_mode_work, msecs_to_jiffies(1000));\n \t}\n \n \terr = sparse_keymap_setup(hp_wmi_input_dev, hp_wmi_keymap, NULL);\n@@ -1331,6 +1358,8 @@ static int __init hp_wmi_input_setup(void)\n \n static void hp_wmi_input_destroy(void)\n {\n+\tcancel_delayed_work_sync(&tablet_mode_work);\n+\tlast_tablet_state = -1;\n \twmi_remove_notify_handler(HPWMI_EVENT_GUID);\n \tinput_unregister_device(hp_wmi_input_dev);\n }\n-- \n2.50.1\n\n","statistics":{"files":1,"additions":32,"deletions":4},"diagnostics":[]}}}}