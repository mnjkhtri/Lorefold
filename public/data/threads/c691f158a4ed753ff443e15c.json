{"schemaVersion":1,"generatedAt":"2026-08-16T16:20:46.501Z","id":"c691f158a4ed753ff443e15c","canonicalUrl":"https://lore.kernel.org/r/20260811192829.123410-1-rosenp%40gmail.com/","channels":["linux-devicetree"],"thread":{"schemaVersion":1,"id":"thread:lore-git:20260811192829.123410-1-rosenp@gmail.com","source":{"kind":"static-generated","canonicalThreadUrl":"https://lore.kernel.org/r/20260811192829.123410-1-rosenp%40gmail.com/","fetchedAt":"2026-08-16T16:20:46.501Z","contentDigest":"lore-git:20260811192829.123410-1-rosenp@gmail.com"},"subject":"Re: [PATCHv2] dt-bindings: net: brcm,bcm4329-fmac: add nvmem-cells for MAC address","messages":{"83ef9f7b-4145-4985-b157-6fb9fbb0b3f0@broadcom.com":{"id":"83ef9f7b-4145-4985-b157-6fb9fbb0b3f0@broadcom.com","messageId":"83ef9f7b-4145-4985-b157-6fb9fbb0b3f0@broadcom.com","references":["20260811192829.123410-1-rosenp@gmail.com"],"missingAncestorIds":["20260811192829.123410-1-rosenp@gmail.com"],"author":{"name":"Arend van Spriel","address":"arend.vanspriel@broadcom.com"},"replyTo":[],"to":[{"name":"Rosen Penev","address":"rosenp@gmail.com"},{"name":"","address":"devicetree@vger.kernel.org"}],"cc":[{"name":"Johannes Berg","address":"johannes@sipsolutions.net"},{"name":"Rob Herring","address":"robh@kernel.org"},{"name":"Krzysztof Kozlowski","address":"krzk+dt@kernel.org"},{"name":"Conor Dooley","address":"conor+dt@kernel.org"},{"name":"van Spriel","address":"arend@broadcom.com"},{"name":"open list:NETWORKING DRIVERS (WIRELESS)","address":"linux-wireless@vger.kernel.org"},{"name":"open list","address":"linux-kernel@vger.kernel.org"}],"timestamp":{"raw":"2026-08-16T09:43:41.000Z","iso":"2026-08-16T09:43:41.000Z","valid":true},"subject":"Re: [PATCHv2] dt-bindings: net: brcm,bcm4329-fmac: add nvmem-cells for MAC address","mailingLists":[{"id":"devicetree.vger.kernel.org","displayName":"devicetree.vger.kernel.org"}],"blocks":[{"kind":"quote","attribution":"On 11/08/2026 21:28, Rosen Penev wrote:","lines":[{"depth":1,"text":"The nvmem-cells and nvmem-cell-names properties are used to supply a"},{"depth":1,"text":"MAC address to the brcmfmac wireless controller. Nodes such as"},{"depth":1,"text":"bcm4709-linksys-ea9200.dts fail dtbs_check with:"},{"depth":1,"text":">      Unevaluated properties are not allowed ('nvmem-cell-names',"},{"depth":1,"text":"     'nvmem-cells' were unexpected)"},{"depth":1,"text":"> nvmem-consumer.yaml cannot be referenced from the common"},{"depth":1,"text":"network-class.yaml because it does not constrain the number of entries"},{"depth":1,"text":"or their names, and not all network devices use the same cell names."},{"depth":1,"text":"Each binding that uses nvmem must therefore define its own"},{"depth":1,"text":"nvmem-cells/nvmem-cell-names constraints, like ethernet-controller.yaml"},{"depth":1,"text":"and qca,ath9k.yaml already do."},{"depth":1,"text":"> Add the single-cell, mac-address-only constraints to the"},{"depth":1,"text":"brcm,bcm4329-fmac binding."},{"depth":1,"text":"> Assisted-by: opencode:deepseek-v4-flash-free"}],"lineCount":14,"maximumDepth":1},{"kind":"paragraph","text":"Probably for this v2 it is better to say:"},{"kind":"paragraph","text":"Suggested-by: Rob Herring <robh@kernel.org>"},{"kind":"quote","lines":[{"depth":1,"text":"Signed-off-by: Rosen Penev <rosenp@gmail.com>"},{"depth":1,"text":"---"},{"depth":1,"text":"  v2: don't use nvmem-consumer.yaml"},{"depth":1,"text":"  .../bindings/net/wireless/brcm,bcm4329-fmac.yaml           | 7 +++++++"},{"depth":1,"text":"  1 file changed, 7 insertions(+)"}],"lineCount":5,"maximumDepth":1}],"patchIds":[],"attachmentMetadata":[],"sourceOrdinal":0,"diagnostics":[],"declaredParentMessageId":"20260811192829.123410-1-rosenp@gmail.com"}},"rootIds":["83ef9f7b-4145-4985-b157-6fb9fbb0b3f0@broadcom.com"],"childrenByParent":{},"chronologicalIds":["83ef9f7b-4145-4985-b157-6fb9fbb0b3f0@broadcom.com"],"patchSeries":[],"diagnostics":[],"patches":{}}}