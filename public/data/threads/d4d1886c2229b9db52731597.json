depth":1,"text":"ACPI companion."},{"depth":1,"text":""},{"depth":1,"text":"Fixes: 3471415c8186 (\"platform/x86: topstar-laptop: Convert ACPI driver to a platform one\")"},{"depth":1,"text":"Signed-off-by: Xueqin Luo <luoxueqin@kylinos.cn>"}],"lineCount":6,"maximumDepth":1},{"kind":"paragraph","text":"I'm not sure why I haven't sent a patch to address this, so"},{"kind":"paragraph","text":"Reviewed-by: Rafael J. Wysocki <rafael.j.wysocki@intel.com>"},{"kind":"quote","lines":[{"depth":1,"text":"---"},{"depth":1,"text":"  drivers/platform/x86/topstar-laptop.c | 6 +++++-"},{"depth":1,"text":"  1 file changed, 5 insertions(+), 1 deletion(-)"},{"depth":1,"text":""},{"depth":1,"text":"diff --git a/drivers/platform/x86/topstar-laptop.c b/drivers/platform/x86/topstar-laptop.c"},{"depth":1,"text":"index 0e842c55dcc5..730a599abf0f 100644"},{"depth":1,"text":"--- a/drivers/platform/x86/topstar-laptop.c"},{"depth":1,"text":"+++ b/drivers/platform/x86/topstar-laptop.c"},{"depth":1,"text":"@@ -287,10 +287,14 @@ static const struct dmi_system_id topstar_dmi_ids[] = {"},{"depth":1,"text":"  >   static int topstar_acpi_probe(struct platform_device *pdev)"},{"depth":1,"text":"  {"},{"depth":1,"text":"-\tstruct acpi_device *device = ACPI_COMPANION(&pdev->dev);"},{"depth":1,"text":"+\tstruct acpi_device *device;"},{"depth":1,"text":"  \tstruct topstar_laptop *topstar;"},{"depth":1,"text":"  \tint err;"},{"depth":1,"text":"  > +\tdevice = ACPI_COMPANION(&pdev->dev);"},{"depth":1,"text":"+\tif (!device)"},{"depth":1,"text":"+\t\treturn -ENODEV;"},{"depth":1,"text":"+"},{"depth":1,"text":"  \tdmi_check_system(topstar_dmi_ids);"},{"depth":1,"text":"  >   \ttopstar = kzalloc_obj(struct topstar_laptop);"}],"lineCount":21,"maximumDepth":1}],"patchIds":[],"attachmentMetadata":[],"sourceOrdinal":0,"diagnostics":[],"declaredParentMessageId":"20260811022115.338595-1-luoxueqin@kylinos.cn"}},"rootIds":["57f89d3a-e2ab-4a79-9bfb-719678671b9a@intel.com"],"childrenByParent":{},"chronologicalIds":["57f8