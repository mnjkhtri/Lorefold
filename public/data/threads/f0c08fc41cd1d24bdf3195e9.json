{"schemaVersion":1,"generatedAt":"2026-08-16T16:20:46.501Z","id":"f0c08fc41cd1d24bdf3195e9","canonicalUrl":"https://lore.kernel.org/r/20260803205011.1249-1-ahmadexp%40gmail.com/","channels":["linux-i2c"],"thread":{"schemaVersion":1,"id":"thread:lore-git:20260803205011.1249-1-ahmadexp@gmail.com","source":{"kind":"static-generated","canonicalThreadUrl":"https://lore.kernel.org/r/20260803205011.1249-1-ahmadexp%40gmail.com/","fetchedAt":"2026-08-16T16:20:46.501Z","contentDigest":"lore-git:20260803205011.1249-1-ahmadexp@gmail.com"},"subject":"Re: [RFC net-next v2 2/6] leds: rgb: Add IS32FL3207 controller driver","messages":{"20260812111248.GH1072730@google.com":{"id":"20260812111248.GH1072730@google.com","messageId":"20260812111248.GH1072730@google.com","references":["20260803205011.1249-1-ahmadexp@gmail.com","20260803205011.1249-3-ahmadexp@gmail.com"],"missingAncestorIds":["20260803205011.1249-3-ahmadexp@gmail.com","20260803205011.1249-1-ahmadexp@gmail.com"],"author":{"name":"Lee Jones","address":"lee@kernel.org"},"replyTo":[],"to":[{"name":"Ahmad Byagowi","address":"ahmadexp@gmail.com"}],"cc":[{"name":"","address":"linux-leds@vger.kernel.org"},{"name":"","address":"devicetree@vger.kernel.org"},{"name":"","address":"linux-i2c@vger.kernel.org"},{"name":"","address":"netdev@vger.kernel.org"},{"name":"Pavel Machek","address":"pavel@kernel.org"},{"name":"Rob Herring","address":"robh@kernel.org"},{"name":"Krzysztof Kozlowski","address":"krzk+dt@kernel.org"},{"name":"Conor Dooley","address":"conor+dt@kernel.org"},{"name":"Andi Shyti","address":"andi.shyti@kernel.org"},{"name":"Peter Rosin","address":"peda@lysator.liu.se"},{"name":"Nam Tran","address":"trannamatk@gmail.com"},{"name":"Vadim Fedorenko","address":"vadim.fedorenko@linux.dev"},{"name":"Richard Cochran","address":"richardcochran@gmail.com"},{"name":"Andrew Lunn","address":"andrew+netdev@lunn.ch"},{"name":"David S. Miller","address":"davem@davemloft.net"},{"name":"Eric Dumazet","address":"edumazet@google.com"},{"name":"Jakub Kicinski","address":"kuba@kernel.org"},{"name":"Paolo Abeni","address":"pabeni@redhat.com"},{"name":"Kees Cook","address":"kees@kernel.org"},{"name":"Gustavo A. R. Silva","address":"gustavoars@kernel.org"},{"name":"","address":"linux-hardening@vger.kernel.org"},{"name":"","address":"linux-kernel@vger.kernel.org"}],"timestamp":{"raw":"2026-08-12T11:12:48.000Z","iso":"2026-08-12T11:12:48.000Z","valid":true},"subject":"Re: [RFC net-next v2 2/6] leds: rgb: Add IS32FL3207 controller driver","mailingLists":[{"id":"linux-i2c.vger.kernel.org","displayName":"linux-i2c.vger.kernel.org"}],"blocks":[{"kind":"paragraph","text":"On Mon, 03 Aug 2026, Ahmad Byagowi wrote:"},{"kind":"quote","lines":[{"depth":1,"text":"Add a generic I2C driver for the Lumissil IS32FL3207 18-channel"},{"depth":1,"text":"LED controller."},{"depth":1,"text":""},{"depth":1,"text":"Expose individual and multicolor LEDs through the LED class. Use the"},{"depth":1,"text":"default 8-bit 62 kHz PWM mode, derive output current from RISET, and"},{"depth":1,"text":"enforce each output current limit with the scaling registers. Honor"},{"depth":1,"text":"initial brightness and retained shutdown state. Handle an optional"},{"depth":1,"text":"supply and enable GPIO, and serialize controller-wide update latches."},{"depth":1,"text":""},{"depth":1,"text":"Signed-off-by: Ahmad Byagowi <ahmadexp@gmail.com>"},{"depth":1,"text":"---"},{"depth":1,"text":" MAINTAINERS                        |   1 +"},{"depth":1,"text":" drivers/leds/rgb/Kconfig           |  11 +"},{"depth":1,"text":" drivers/leds/rgb/Makefile          |   1 +"},{"depth":1,"text":" drivers/leds/rgb/leds-is32fl3207.c | 580 +++++++++++++++++++++++++++++"},{"depth":1,"text":" 4 files changed, 593 insertions(+)"},{"depth":1,"text":" create mode 100644 drivers/leds/rgb/leds-is32fl3207.c"}],"lineCount":17,"maximumDepth":1},{"kind":"paragraph","text":"Looking pretty good now - couple of nits."},{"kind":"quote","lines":[{"depth":1,"text":"diff --git \"a/MAINTAINERS\" \"b/MAINTAINERS\""},{"depth":1,"text":"index 744296f1c..8f2386fd5 100644"},{"depth":1,"text":"--- a/MAINTAINERS"},{"depth":1,"text":"+++ b/MAINTAINERS"},{"depth":1,"text":"@@ -13833,6 +13833,7 @@ M:\tAhmad Byagowi <ahmadexp@gmail.com>"},{"depth":1,"text":" L:\tlinux-leds@vger.kernel.org"},{"depth":1,"text":" S:\tMaintained"},{"depth":1,"text":" F:\tDocumentation/devicetree/bindings/leds/issi,is32fl3207.yaml"},{"depth":1,"text":"+F:\tdrivers/leds/rgb/leds-is32fl3207.c"},{"depth":1,"text":" "},{"depth":1,"text":" IT87 HARDWARE MONITORING DRIVER"},{"depth":1,"text":" M:\tJean Delvare <jdelvare@suse.com>"},{"depth":1,"text":"diff --git \"a/drivers/leds/rgb/Kconfig\" \"b/drivers/leds/rgb/Kconfig\""},{"depth":1,"text":"index 6e9ab5f60..c896be131 100644"},{"depth":1,"text":"--- a/drivers/leds/rgb/Kconfig"},{"depth":1,"text":"+++ b/drivers/leds/rgb/Kconfig"},{"depth":1,"text":"@@ -14,6 +14,17 @@ config LEDS_GROUP_MULTICOLOR"},{"depth":1,"text":" \t  To compile this driver as a module, choose M here: the module"},{"depth":1,"text":" \t  will be called leds-group-multicolor."},{"depth":1,"text":" "},{"depth":1,"text":"+config LEDS_IS32FL3207"},{"depth":1,"text":"+\ttristate \"LED support for ISSI IS32FL3207\""},{"depth":1,"text":"+\tdepends on I2C"},{"depth":1,"text":"+\tselect REGMAP_I2C"},{"depth":1,"text":"+\thelp"},{"depth":1,"text":"+\t  Say Y here to include support for the Lumissil IS32FL3207"},{"depth":1,"text":"+\t  18-channel I2C LED controller."},{"depth":1,"text":"+"},{"depth":1,"text":"+\t  To compile this driver as a module, choose M here: the module will"},{"depth":1,"text":"+\t  be called leds-is32fl3207."},{"depth":1,"text":"+"},{"depth":1,"text":" config LEDS_KTD202X"},{"depth":1,"text":" \ttristate \"LED support for KTD202x Chips\""},{"depth":1,"text":" \tdepends on I2C"},{"depth":1,"text":"diff --git \"a/drivers/leds/rgb/Makefile\" \"b/drivers/leds/rgb/Makefile\""},{"depth":1,"text":"index cc0f2df66..228923e8b 100644"},{"depth":1,"text":"--- a/drivers/leds/rgb/Makefile"},{"depth":1,"text":"+++ b/drivers/leds/rgb/Makefile"},{"depth":1,"text":"@@ -1,6 +1,7 @@"},{"depth":1,"text":" # SPDX-License-Identifier: GPL-2.0"},{"depth":1,"text":" "},{"depth":1,"text":" obj-$(CONFIG_LEDS_GROUP_MULTICOLOR)\t+= leds-group-multicolor.o"},{"depth":1,"text":"+obj-$(CONFIG_LEDS_IS32FL3207)\t\t+= leds-is32fl3207.o"},{"depth":1,"text":" obj-$(CONFIG_LEDS_KTD202X)\t\t+= leds-ktd202x.o"},{"depth":1,"text":" obj-$(CONFIG_LEDS_LP5812)\t\t+= leds-lp5812.o"},{"depth":1,"text":" obj-$(CONFIG_LEDS_LP5860_CORE)\t\t+= leds-lp5860-core.o"},{"depth":1,"text":"diff --git \"a/drivers/leds/rgb/leds-is32fl3207.c\" \"b/drivers/leds/rgb/leds-is32fl3207.c"},{"depth":1,"text":"new file mode 100644"},{"depth":1,"text":"index 000000000..08843da96"},{"depth":1,"text":"--- /dev/null"},{"depth":1,"text":"+++ b/drivers/leds/rgb/leds-is32fl3207.c"},{"depth":1,"text":"@@ -0,0 +1,580 @@"},{"depth":1,"text":"+// SPDX-License-Identifier: GPL-2.0-only"},{"depth":1,"text":"+/*"},{"depth":1,"text":"+ * ISSI IS32FL3207 LED controller driver"},{"depth":1,"text":"+ *"},{"depth":1,"text":"+ * Copyright 2026 Ahmad Byagowi"}],"lineCount":57,"maximumDepth":1},{"kind":"paragraph","text":"Personal copyright?  Is this okay with ISSI?"},{"kind":"quote","lines":[{"depth":1,"text":"+ */"},{"depth":1,"text":"+"},{"depth":1,"text":"+#include <linux/bitmap.h>"},{"depth":1,"text":"+#include <linux/delay.h>"},{"depth":1,"text":"+#include <linux/gpio/consumer.h>"},{"depth":1,"text":"+#include <linux/i2c.h>"},{"depth":1,"text":"+#include <linux/led-class-multicolor.h>"},{"depth":1,"text":"+#include <linux/math64.h>"},{"depth":1,"text":"+#include <linux/module.h>"},{"depth":1,"text":"+#include <linux/mutex.h>"},{"depth":1,"text":"+#include <linux/property.h>"},{"depth":1,"text":"+#include <linux/regmap.h>"},{"depth":1,"text":"+#include <linux/regulator/consumer.h>"},{"depth":1,"text":"+#include <linux/string.h>"},{"depth":1,"text":"+"},{"depth":1,"text":"+#include <dt-bindings/leds/common.h>"},{"depth":1,"text":"+"},{"depth":1,"text":"+#define IS32FL3207_NUM_CHANNELS\t\t18"},{"depth":1,"text":"+#define IS32FL3207_MAX_BRIGHTNESS\t255"},{"depth":1,"text":"+"},{"depth":1,"text":"+#define IS32FL3207_REG_CONTROL\t\t0x00"},{"depth":1,"text":"+#define IS32FL3207_REG_PWM_LOW(channel)\t(0x01 + 2 * (channel))"},{"depth":1,"text":"+#define IS32FL3207_REG_PWM_UPDATE\t0x49"},{"depth":1,"text":"+#define IS32FL3207_REG_SCALING(channel)\t(0x4a + (channel))"},{"depth":1,"text":"+#define IS32FL3207_REG_GLOBAL_CURRENT\t0x6e"},{"depth":1,"text":"+#define IS32FL3207_REG_RESET\t\t0x7f"},{"depth":1,"text":"+"},{"depth":1,"text":"+#define IS32FL3207_CONTROL_ENABLE\tBIT(0)"},{"depth":1,"text":"+#define IS32FL3207_GLOBAL_CURRENT_MAX\t0xff"},{"depth":1,"text":"+"},{"depth":1,"text":"+/* IOUT(MAX) in microamperes = 76,500,000 / RISET in ohms. */"},{"depth":1,"text":"+#define IS32FL3207_CURRENT_NUMERATOR\t76500000ULL"},{"depth":1,"text":"+"},{"depth":1,"text":"+struct is32fl3207;"}],"lineCount":34,"maximumDepth":1},{"kind":"paragraph","text":"No forward declarations."},{"kind":"paragraph","text":"This should not be possible:"},{"kind":"paragraph","text":"chip->leds[i]->chip->leds[i]->chip->leds[i]->chip->leds[i]->[...]"},{"kind":"paragraph","text":"We usually use container_of()"},{"kind":"quote","lines":[{"depth":1,"text":"+struct is32fl3207_led {"},{"depth":1,"text":"+\tstruct is32fl3207 *chip;"},{"depth":1,"text":"+\tstruct led_classdev *led_cdev;"},{"depth":1,"text":"+\tunion {"},{"depth":1,"text":"+\t\tstruct led_classdev cdev;"},{"depth":1,"text":"+\t\tstruct led_classdev_mc mcdev;"},{"depth":1,"text":"+\t};"},{"depth":1,"text":"+\tunsigned int channel;"},{"depth":1,"text":"+};"},{"depth":1,"text":"+"},{"depth":1,"text":"+struct is32fl3207 {"},{"depth":1,"text":"+\tstruct device *dev;"},{"depth":1,"text":"+\tstruct regmap *regmap;"},{"depth":1,"text":"+\tstruct gpio_desc *enable_gpio;"},{"depth":1,"text":"+\tstruct mutex lock; /* Serializes controller register updates. */"},{"depth":1,"text":"+\tunsigned long channels[BITS_TO_LONGS(IS32FL3207_NUM_CHANNELS)];"},{"depth":1,"text":"+\tu32 output_max_microamp;"},{"depth":1,"text":"+\tunsigned int num_leds;"},{"depth":1,"text":"+\tstruct is32fl3207_led leds[] __counted_by(num_leds);"},{"depth":1,"text":"+};"},{"depth":1,"text":"+"},{"depth":1,"text":"+static int is32fl3207_parse_led_properties(struct is32fl3207 *chip,"},{"depth":1,"text":"+\t\t\t\t\t   struct fwnode_handle *fwnode,"},{"depth":1,"text":"+\t\t\t\t\t   unsigned int *max_brightness,"},{"depth":1,"text":"+\t\t\t\t\t   unsigned int *brightness)"},{"depth":1,"text":"+{"},{"depth":1,"text":"+\tenum led_default_state default_state;"},{"depth":1,"text":"+\tu32 value;"},{"depth":1,"text":"+\tint ret;"},{"depth":1,"text":"+"},{"depth":1,"text":"+\t*max_brightness = IS32FL3207_MAX_BRIGHTNESS;"},{"depth":1,"text":"+\tif (fwnode_property_present(fwnode, \"max-brightness\")) {"},{"depth":1,"text":"+\t\tret = fwnode_property_read_u32(fwnode, \"max-brightness\", &value);"},{"depth":1,"text":"+\t\tif (ret)"},{"depth":1,"text":"+\t\t\treturn dev_err_probe(chip->dev, ret,"},{"depth":1,"text":"+\t\t\t\t\t     \"failed to read maximum brightness for %pfw\\n\","},{"depth":1,"text":"+\t\t\t\t\t     fwnode);"},{"depth":1,"text":"+\t\tif (!value || value > IS32FL3207_MAX_BRIGHTNESS)"},{"depth":1,"text":"+\t\t\treturn dev_err_probe(chip->dev, -EINVAL,"},{"depth":1,"text":"+\t\t\t\t\t     \"invalid maximum brightness %u for %pfw\\n\","},{"depth":1,"text":"+\t\t\t\t\t     value, fwnode);"},{"depth":1,"text":"+"},{"depth":1,"text":"+\t\t*max_brightness = value;"},{"depth":1,"text":"+\t}"},{"depth":1,"text":"+"},{"depth":1,"text":"+\tvalue = *max_brightness;"},{"depth":1,"text":"+\tif (fwnode_property_present(fwnode, \"default-brightness\")) {"},{"depth":1,"text":"+\t\tret = fwnode_property_read_u32(fwnode, \"default-brightness\","},{"depth":1,"text":"+\t\t\t\t\t       &value);"},{"depth":1,"text":"+\t\tif (ret)"},{"depth":1,"text":"+\t\t\treturn dev_err_probe(chip->dev, ret,"},{"depth":1,"text":"+\t\t\t\t\t     \"failed to read default brightness for %pfw\\n\","},{"depth":1,"text":"+\t\t\t\t\t     fwnode);"},{"depth":1,"text":"+\t\tif (value > *max_brightness)"},{"depth":1,"text":"+\t\t\treturn dev_err_probe(chip->dev, -EINVAL,"},{"depth":1,"text":"+\t\t\t\t\t     \"invalid default brightness %u for %pfw\\n\","},{"depth":1,"text":"+\t\t\t\t\t     value, fwnode);"},{"depth":1,"text":"+\t}"},{"depth":1,"text":"+"},{"depth":1,"text":"+\tdefault_state = led_init_default_state_get(fwnode);"},{"depth":1,"text":"+\tif (default_state == LEDS_DEFSTATE_KEEP)"},{"depth":1,"text":"+\t\treturn dev_err_probe(chip->dev, -EINVAL,"},{"depth":1,"text":"+\t\t\t\t     \"default state keep is not supported for %pfw\\n\","},{"depth":1,"text":"+\t\t\t\t     fwnode);"},{"depth":1,"text":"+"},{"depth":1,"text":"+\t*brightness = default_state == LEDS_DEFSTATE_ON ? value : LED_OFF;"}],"lineCount":66,"maximumDepth":1},{"kind":"paragraph","text":"Why not return brightness instead of passing around pointers to ints?"},{"kind":"quote","lines":[{"depth":1,"text":"+\treturn 0;"},{"depth":1,"text":"+}"},{"depth":1,"text":"+"},{"depth":1,"text":"+static int is32fl3207_validate_component(struct is32fl3207 *chip,"},{"depth":1,"text":"+\t\t\t\t\t struct fwnode_handle *fwnode)"},{"depth":1,"text":"+{"},{"depth":1,"text":"+\tstatic const char * const unsupported[] = {"},{"depth":1,"text":"+\t\t\"default-brightness\","},{"depth":1,"text":"+\t\t\"default-state\","},{"depth":1,"text":"+\t\t\"max-brightness\","},{"depth":1,"text":"+\t\t\"retain-state-shutdown\","},{"depth":1,"text":"+\t};"},{"depth":1,"text":"+\tunsigned int i;"}],"lineCount":13,"maximumDepth":1},{"kind":"paragraph","text":"Put this in the for():"},{"kind":"paragraph","text":"for (int i = 0; ..."},{"kind":"paragraph","text":"Same for all of the others."},{"kind":"quote","lines":[{"depth":1,"text":"+"},{"depth":1,"text":"+\tfor (i = 0; i < ARRAY_SIZE(unsupported); i++)"}],"lineCount":2,"maximumDepth":1},{"kind":"paragraph","text":"Put this in braces."},{"kind":"paragraph","text":"I wonder if checkpatch.pl would pick this up?"},{"kind":"quote","lines":[{"depth":1,"text":"+\t\tif (fwnode_property_present(fwnode, unsupported[i]))"},{"depth":1,"text":"+\t\t\treturn dev_err_probe(chip->dev, -EINVAL,"},{"depth":1,"text":"+\t\t\t\t\t     \"%s is not supported for component %pfw\\n\","},{"depth":1,"text":"+\t\t\t\t\t     unsupported[i], fwnode);"},{"depth":1,"text":"+"},{"depth":1,"text":"+\treturn 0;"},{"depth":1,"text":"+}"},{"depth":1,"text":"+"},{"depth":1,"text":"+static int is32fl3207_write_channels(struct is32fl3207 *chip,"},{"depth":1,"text":"+\t\t\t\t     const struct mc_subled *subleds,"},{"depth":1,"text":"+\t\t\t\t     unsigned int num_channels)"},{"depth":1,"text":"+{"},{"depth":1,"text":"+\tunsigned int i;"},{"depth":1,"text":"+\tint ret;"},{"depth":1,"text":"+"},{"depth":1,"text":"+\tguard(mutex)(&chip->lock);"},{"depth":1,"text":"+"},{"depth":1,"text":"+\tfor (i = 0; i < num_channels; i++) {"}],"lineCount":18,"maximumDepth":1},{"kind":"paragraph","text":"The number of channels that you write two always start at 0?"},{"kind":"quote","lines":[{"depth":1,"text":"+\t\tret = regmap_write(chip->regmap,"},{"depth":1,"text":"+\t\t\t\t   IS32FL3207_REG_PWM_LOW(subleds[i].channel),"},{"depth":1,"text":"+\t\t\t\t   subleds[i].brightness);"},{"depth":1,"text":"+\t\tif (ret)"},{"depth":1,"text":"+\t\t\treturn ret;"},{"depth":1,"text":"+\t}"},{"depth":1,"text":"+"},{"depth":1,"text":"+\treturn regmap_write(chip->regmap, IS32FL3207_REG_PWM_UPDATE, 0);"},{"depth":1,"text":"+}"},{"depth":1,"text":"+"},{"depth":1,"text":"+static int is32fl3207_brightness_set(struct led_classdev *cdev,"},{"depth":1,"text":"+\t\t\t\t     enum led_brightness brightness)"},{"depth":1,"text":"+{"},{"depth":1,"text":"+\tstruct is32fl3207_led *led = container_of(cdev, struct is32fl3207_led,"},{"depth":1,"text":"+\t\t\t\t\t\t     cdev);"}],"lineCount":15,"maximumDepth":1},{"kind":"paragraph","text":"Use 100-chars everywhere."},{"kind":"quote","lines":[{"depth":1,"text":"+\tstruct mc_subled subled = {"},{"depth":1,"text":"+\t\t.brightness = brightness,"},{"depth":1,"text":"+\t\t.channel = led->channel,"},{"depth":1,"text":"+\t};"},{"depth":1,"text":"+"},{"depth":1,"text":"+\treturn is32fl3207_write_channels(led->chip, &subled, 1);"},{"depth":1,"text":"+}"},{"depth":1,"text":"+"},{"depth":1,"text":"+static int is32fl3207_mc_brightness_set(struct led_classdev *cdev,"},{"depth":1,"text":"+\t\t\t\t\tenum led_brightness brightness)"},{"depth":1,"text":"+{"},{"depth":1,"text":"+\tstruct led_classdev_mc *mcdev = lcdev_to_mccdev(cdev);"},{"depth":1,"text":"+\tstruct is32fl3207_led *led = container_of(mcdev, struct is32fl3207_led,"},{"depth":1,"text":"+\t\t\t\t\t\t     mcdev);"},{"depth":1,"text":"+"},{"depth":1,"text":"+\tled_mc_calc_color_components(mcdev, brightness);"},{"depth":1,"text":"+"},{"depth":1,"text":"+\treturn is32fl3207_write_channels(led->chip, mcdev->subled_info,"},{"depth":1,"text":"+\t\t\t\t\t    mcdev->num_colors);"},{"depth":1,"text":"+}"},{"depth":1,"text":"+"},{"depth":1,"text":"+static int is32fl3207_configure_channel(struct is32fl3207 *chip,"},{"depth":1,"text":"+\t\t\t\t\tstruct fwnode_handle *fwnode,"},{"depth":1,"text":"+\t\t\t\t\tunsigned int *channel)"},{"depth":1,"text":"+{"},{"depth":1,"text":"+\tu64 scaling;"},{"depth":1,"text":"+\tu32 max_microamp;"},{"depth":1,"text":"+\tu32 reg;"},{"depth":1,"text":"+\tint ret;"},{"depth":1,"text":"+"},{"depth":1,"text":"+\tret = fwnode_property_read_u32(fwnode, \"reg\", &reg);"},{"depth":1,"text":"+\tif (ret)"},{"depth":1,"text":"+\t\treturn dev_err_probe(chip->dev, ret,"},{"depth":1,"text":"+\t\t\t\t     \"failed to read channel for %pfw\\n\", fwnode);"},{"depth":1,"text":"+"},{"depth":1,"text":"+\tif (reg >= IS32FL3207_NUM_CHANNELS)"},{"depth":1,"text":"+\t\treturn dev_err_probe(chip->dev, -EINVAL,"},{"depth":1,"text":"+\t\t\t\t     \"channel %u is out of range\\n\", reg);"},{"depth":1,"text":"+"},{"depth":1,"text":"+\tif (test_bit(reg, chip->channels))"},{"depth":1,"text":"+\t\treturn dev_err_probe(chip->dev, -EINVAL,"},{"depth":1,"text":"+\t\t\t\t     \"channel %u is used more than once\\n\", reg);"},{"depth":1,"text":"+"},{"depth":1,"text":"+\tret = fwnode_property_read_u32(fwnode, \"led-max-microamp\","},{"depth":1,"text":"+\t\t\t\t       &max_microamp);"}],"lineCount":45,"maximumDepth":1},{"kind":"paragraph","text":"Odd wrap."},{"kind":"quote","lines":[{"depth":1,"text":"+\tif (ret)"},{"depth":1,"text":"+\t\treturn dev_err_probe(chip->dev, ret,"},{"depth":1,"text":"+\t\t\t\t     \"failed to read current limit for channel %u\\n\","},{"depth":1,"text":"+\t\t\t\t     reg);"},{"depth":1,"text":"+"},{"depth":1,"text":"+\tif (!max_microamp || max_microamp > chip->output_max_microamp)"},{"depth":1,"text":"+\t\treturn dev_err_probe(chip->dev, -EINVAL,"},{"depth":1,"text":"+\t\t\t\t     \"invalid current limit %u uA for channel %u\\n\","},{"depth":1,"text":"+\t\t\t\t     max_microamp, reg);"},{"depth":1,"text":"+"},{"depth":1,"text":"+\t/* GCC is fixed at 0xff, so use each output's scaling register. */"},{"depth":1,"text":"+\tscaling = div_u64((u64)max_microamp * 256 * 256,"}],"lineCount":12,"maximumDepth":1},{"kind":"paragraph","text":"No magic numbers.  Define whatever these are so we don't have to guess."},{"kind":"quote","lines":[{"depth":1,"text":"+\t\t\t  (u64)chip->output_max_microamp *"},{"depth":1,"text":"+\t\t\t  IS32FL3207_GLOBAL_CURRENT_MAX);"},{"depth":1,"text":"+\tif (!scaling)"},{"depth":1,"text":"+\t\treturn dev_err_probe(chip->dev, -EINVAL,"},{"depth":1,"text":"+\t\t\t\t     \"current limit %u uA is below channel %u resolution\\n\","},{"depth":1,"text":"+\t\t\t\t     max_microamp, reg);"},{"depth":1,"text":"+"},{"depth":1,"text":"+\tscaling = min_t(u64, scaling, 0xff);"}],"lineCount":8,"maximumDepth":1},{"kind":"paragraph","text":"Here as well and everywhere else you use raw values."},{"kind":"quote","lines":[{"depth":1,"tex