"depth":1,"text":"+\t\tif (fwnode_get_child_node_count(child))"},{"depth":1,"text":"+\t\t\tret = is32fl3207_register_multicolor(chip, child, led);"},{"depth":1,"text":"+\t\telse"},{"depth":1,"text":"+\t\t\tret = is32fl3207_register_single(chip, child, led);"},{"depth":1,"text":"+\t\tif (ret)"},{"depth":1,"text":"+\t\t\treturn ret;"},{"depth":1,"text":"+"},{"depth":1,"text":"+\t\ti++;"},{"depth":1,"text":"+\t}"},{"depth":1,"text":"+"},{"depth":1,"text":"+\treturn 0;"},{"depth":1,"text":"+}"},{"depth":1,"text":"+"},{"depth":1,"text":"+static void is32fl3207_shutdown(struct i2c_client *client)"},{"depth":1,"text":"+{"},{"depth":1,"text":"+\tstruct is32fl3207 *chip = i2c_get_clientdata(client);"},{"depth":1,"text":"+\tbool retain_state = false;"},{"depth":1,"text":"+\tunsigned int i;"},{"depth":1,"text":"+"},{"depth":1,"text":"+\tfor (i = 0; i < chip->num_leds; i++)"}],"lineCount":63,"maximumDepth":1},{"kind":"paragraph","text":"\"Also, use braces when a loop contains more than a single simple statement\""},{"kind":"paragraph","text":"Goes for everywhere.  Make sure you run checkpatch.pl."},{"kind":"quote","lines":[{"depth":1,"text":"+\t\tif (chip->leds[i].led_cdev->flags & LED_RETAIN_AT_SHUTDOWN) {"},{"depth":1,"text":"+\t\t\tretain_state = true;"},{"depth":1,"text":"+\t\t\tbreak;"},{"depth":1,"text":"+\t\t}"},{"depth":1,"text":"+"},{"depth":1,"text":"+\tif (!retain_state) {"},{"depth":1,"text":"+\t\tis32fl3207_disable(chip);"},{"depth":1,"text":"+\t\treturn;"},{"depth":1,"text":"+\t}"},{"depth":1,"text":"+"},{"depth":1,"text":"+\tfor (i = 0; i < chip->num_leds; i++) {"},{"depth":1,"text":"+\t\tstruct led_classdev *cdev = chip->leds[i].led_cdev;"},{"depth":1,"text":"+"},{"depth":1,"text":"+\t\tif (cdev->flags & LED_RETAIN_AT_SHUTDOWN)"},{"depth":1,"text":"+\t\t\tcontinue;"}],"lineCount":15,"maximumDepth":1},{"kind":"paragraph","text":"'\\n'"},{"kind":"quote","lines":[{"depth":1,"text":"+\t\tif (cdev->flags & LED_MULTI_COLOR)"},{"depth":1,"text":"+\t\t\tis32fl3207_mc_brightness_set(cdev, LED_OFF);"},{"depth":1,"text":"+\t\telse"},{"depth":1,"text":"+\t\t\tis32fl3207_brightness_set(cdev, LED_OFF);"},{"depth":1,"text":"+\t}"},{"depth":1,"text":"+}"},{"depth":1,"text":"+"},{"depth":1,"text":"+static const struct of_device_id is32fl3207_of_match[] = {"},{"depth":1,"text":"+\t{ .compatible = \"issi,is32fl3207\" },"},{"depth":1,"text":"+\t{ }"},{"depth":1,"text":"+};"},{"depth":1,"text":"+MODULE_DEVICE_TABLE(of, is32fl3207_of_match);"},{"depth":1,"text":"+"},{"depth":1,"text":"+static const struct i2c_device_id is32fl3207_id[] = {"},{"depth":1,"text":"+\t{ .name = \"is32fl3207\" },"},{"depth":1,"text":"+\t{ }"},{"depth":1,"text":"+};"},{"depth":1,"text":"+MODULE_DEVICE_TABLE(i2c, is32fl3207_id);"},{"depth":1,"text":"+"},{"depth":1,"text":"+static struct i2c_driver is32fl3207_driver = {"},{"depth":1,"text":"+\t.driver = {"},{"depth":1,"text":"+\t\t.name = \"is32fl3207\","},{"depth":1,"text":"+\t\t.of_match_table = is32fl3207_of_match,"},{"depth":1,"text":"+\t},"},{"depth":1,"text":"+\t.probe = is32fl3207_probe,"},{"depth":1,"text":"+\t.shutdown = is32fl3207_shutdown,"},{"depth":1,"text":"+\t.id_table = is32fl3207_id,"},{"depth":1,"text":"+};"},{"depth":1,"text":"+module_i2c_driver(is32fl3207_driver);"},{"depth":1,"text":"+"},{"depth":1,"text":"+MODULE_AUTHOR(\"Ahmad Byagowi <ahmadexp@gmail.com>\");"},{"depth":1,"text":"+MODULE_DESCRIPTION(\"Lumissil IS32FL3207 LED controller driver\");"}],"lineCount":32,"maximumDepth":1},{"kind":"paragraph","text":"Lumissil != ISSI - so which is it?"},{"kind":"quote","lines":[{"depth":1,"text":"+MODULE_LICENSE(\"GPL\");"},{"depth":1,"text":"-- "},{"depth":1,"text":"2.50.1 (Apple Git-155)"},{"depth":1,"text":""}],"lineCount":4,"maximumDepth":1},{"kind":"signature","text":"Lee Jones","lineCount":1}],"patchIds":[],"attachmentMetadata":[],"sourceOrdinal":0,"diagnostics":[],"declaredParentMessageId":"20260803205011.1249-3-ahmadexp@gmail.com"}},"rootIds":["20260812111248.GH1072730@google.com"],"childrenByParen