_probe(struct platform_device *pdev)"},{"depth":1,"text":" \t * dma_request_channel()."},{"depth":1,"text":" \t */"},{"depth":1,"text":" \tif (pdev->dev.of_node) {"},{"depth":1,"text":"-\t\terr = of_dma_controller_register(pdev->dev.of_node,"},{"depth":1,"text":"+\t\terr = devm_of_dma_controller_register(&pdev->dev, pdev->dev.of_node,"},{"depth":1,"text":" \t\t\t\t\t\t at_dma_xlate, atdma);"},{"depth":1,"text":" \t\tif (err) {"},{"depth":1,"text":" \t\t\tdev_err(&pdev->dev, \"could not register of_dma_controller\\n\");"},{"depth":1,"text":"-\t\t\tgoto err_of_dma_controller_register;"},{"depth":1,"text":"+\t\t\treturn err;"},{"depth":1,"text":" \t\t}"},{"depth":1,"text":" \t}"},{"depth":1,"text":""},{"depth":1,"text":" \treturn 0;"},{"depth":1,"text":"-"},{"depth":1,"text":"-err_of_dma_controller_register:"},{"depth":1,"text":"-\tdma_async_device_unregister(&atdma->dma_device);"},{"depth":1,"text":"-err_dma_async_device_register:"},{"depth":1,"text":"-\tdma_pool_destroy(atdma->memset_pool);"},{"depth":1,"text":"-err_memset_pool_create:"},{"depth":1,"text":"-\tdma_pool_destroy(atdma->lli_pool);"},{"depth":1,"text":"-err_desc_pool_create:"},{"depth":1,"text":"-\tfree_irq(platform_get_irq(pdev, 0), atdma);"},{"depth":1,"text":"-err_irq:"},{"depth":1,"text":"-\tclk_disable_unprepare(atdma->clk);"},{"depth":1,"text":"-\treturn err;"},{"depth":1,"text":" }"},{"depth":1,"text":""},{"depth":1,"text":" static void at_dma_remove(struct platform_device *pdev)"},{"depth":1,"text":"@@ -2121,22 +2103,12 @@ static void at_dma_remove(struct platform_device *pdev)"},{"depth":1,"text":" \tstruct dma_chan\t\t*chan, *_chan;"},{"depth":1,"text":""},{"depth":1,"text":" \tat_dma_off(atdma);"},{"depth":1,"text":"-\tif (pdev->dev.of_node)"},{"depth":1,"text":"-\t\tof_dma_controller_free(pdev->dev.of_node);"},{"depth":1,"text":"-\tdma_async_device_unregister(&atdma->dma_device);"},{"depth":1,"text":"-"},{"depth":1,"text":"-\tdma_pool_destroy(atdma->memset_pool);"},{"depth":1,"text":"-\tdma_pool_destroy(atdma->lli_pool);"},{"depth":1,"text":"-\tfree_irq(platform_get_irq(pdev, 0), atdma);"},{"depth":1,"text":""},{"depth":1,"text":" \tlist_for_each_entry_safe(chan, _chan, &atdma->dma_device.channels,"},{"depth":1,"text":" \t\t\tdevice_node) {"},{"depth":1,"text":" \t\t/* Disable interrupts */"},{"depth":1,"text":" \t\tatc_disable_chan_irq(atdma, chan->chan_id);"},{"depth":1,"text":"-\t\tlist_del(&chan->device_node);"},{"depth":1,"text":" \t}"},{"depth":1,"text":"-"},{"depth":1,"text":"-\tclk_disable_unprepare(atdma->clk);"},{"depth":1,"text":" }"},{"depth":1,"text":""},{"depth":1,"text":" static void at_dma_shutdown(struct platform_device *pdev)"},{"depth":1,"text":"--"},{"depth":1,"text":"2.55.0"},{"depth":1,"text":""}],"lineCount":128,"maximumDepth":1}],"patchIds":[],"attachmentMetadata":[],"sourceOrdinal":0,"diagnostics":[],"declaredParentMessageId":"20260724225720.43410-1-rosenp@gmail.com"}},"rootIds":["an-D4k84MUptmfkF@lizhi-Precision-Tower-5810"],"childrenByParent":{},"chronologicalIds":["an-D4k84MUptmfkF@lizhi-Precision-Tower-5810"],"patchSeries":[],"diagnostics":[],"patches":{}}}