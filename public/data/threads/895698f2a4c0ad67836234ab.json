{"schemaVersion":1,"generatedAt":"2026-08-16T16:08:54.557Z","id":"895698f2a4c0ad67836234ab","canonicalUrl":"https://lore.kernel.org/r/20260723211739.289699-1-vz%40kernel.org/","channels":["dmaengine"],"thread":{"schemaVersion":1,"id":"thread:lore-git:20260723211739.289699-1-vz@kernel.org","source":{"kind":"static-generated","canonicalThreadUrl":"https://lore.kernel.org/r/20260723211739.289699-1-vz%40kernel.org/","fetchedAt":"2026-08-16T16:08:54.557Z","contentDigest":"lore-git:20260723211739.289699-1-vz@kernel.org"},"subject":"Re: [PATCH] dmaengine: pl08x: Create debugfs stats file under device folder","messages":{"an-FVzIRAGMj8hX_@lizhi-Precision-Tower-5810":{"id":"an-FVzIRAGMj8hX_@lizhi-Precision-Tower-5810","messageId":"an-FVzIRAGMj8hX_@lizhi-Precision-Tower-5810","references":["20260723211739.289699-1-vz@kernel.org"],"missingAncestorIds":["20260723211739.289699-1-vz@kernel.org"],"author":{"name":"Frank Li","address":"Frank.li@oss.nxp.com"},"timestamp":{"raw":"2026-08-14T21:15:03.000Z","iso":"2026-08-14T21:15:03.000Z","valid":true},"subject":"Re: [PATCH] dmaengine: pl08x: Create debugfs stats file under device folder","mailingLists":[{"id":"dmaengine.vger.kernel.org","displayName":"dmaengine.vger.kernel.org"}],"blocks":[{"kind":"quote","attribution":"On Fri, Jul 24, 2026 at 12:17:39AM +0300, Vladimir Zapolskiy wrote:","lines":[{"depth":1,"text":"If parent folder for a debug file is not set, then this file is created"},{"depth":1,"text":"right in top debugfs mountpoint directory, which is undesired. However"},{"depth":1,"text":"for every DMA controller device its dedicated folder below 'dmaengine'"},{"depth":1,"text":"is created by dma_async_device_register(), and this particular folder"},{"depth":1,"text":"is expected to store all device specific debug files."},{"depth":1,"text":""},{"depth":1,"text":"The new name \"stats\" is selected as the most popular debugfs file name"},{"depth":1,"text":"found in other DMA controller device drivers, and the macro constant"},{"depth":1,"text":"for file mode is replaced by the octal value."},{"depth":1,"text":""},{"depth":1,"text":"Signed-off-by: Vladimir Zapolskiy <vz@kernel.org>"},{"depth":1,"text":"---"}],"lineCount":12,"maximumDepth":1},{"kind":"paragraph","text":"Reviewed-by: Frank Li <Frank.Li@nxp.com>"},{"kind":"quote","lines":[{"depth":1,"text":" drivers/dma/amba-pl08x.c | 4 ++--"},{"depth":1,"text":" 1 file changed, 2 insertions(+), 2 deletions(-)"},{"depth":1,"text":""},{"depth":1,"text":"diff --git a/drivers/dma/amba-pl08x.c b/drivers/dma/amba-pl08x.c"},{"depth":1,"text":"index 5e88fd44812d..543c2eb8cfa8 100644"},{"depth":1,"text":"--- a/drivers/dma/amba-pl08x.c"},{"depth":1,"text":"+++ b/drivers/dma/amba-pl08x.c"},{"depth":1,"text":"@@ -2500,8 +2500,8 @@ DEFINE_SHOW_ATTRIBUTE(pl08x_debugfs);"},{"depth":1,"text":" static void init_pl08x_debugfs(struct pl08x_driver_data *pl08x)"},{"depth":1,"text":" {"},{"depth":1,"text":" \t/* Expose a simple debugfs interface to view all clocks */"},{"depth":1,"text":"-\tdebugfs_create_file(dev_name(&pl08x->adev->dev), S_IFREG | S_IRUGO,"},{"depth":1,"text":"-\t\t\t    NULL, pl08x, &pl08x_debugfs_fops);"},{"depth":1,"text":"+\tdebugfs_create_file(\"stats\", 0444, pl08x->memcpy.dbg_dev_root,"},{"depth":1,"text":"+\t\t\t    pl08x, &pl08x_debugfs_fops);"},{"depth":1,"text":" }"},{"depth":1,"text":""},{"depth":1,"text":" #else"},{"depth":1,"text":"--"},{"depth":1,"text":"2.51.0"},{"depth":1,"text":""}],"lineCount":21,"maximumDepth":1}],"patchIds":[],"attachmentMetadata":[],"sourceOrdinal":0,"diagnostics":[],"declaredParentMessageId":"20260723211739.289699-1-vz@kernel.org"}},"rootIds":["an-FVzIRAGMj8hX_@lizhi-Precision-Tower-5810"],"childrenByParent":{},"chronologicalIds":["an-FVzIRAGMj8hX_@lizhi-Precision-Tower-5810"],"patchSeries":[],"diagnostics":[],"patches":{}}}